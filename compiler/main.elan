@strict

#include <builtin/fs> as fs
#include <builtin/path> as path

enum Tok {
    Ident,
    Keyword,
    Number,
    String,
    Plus,
    Minus,
    Star,
    Slash,
    EqEq,
    BangEq,
    Bang,
    Lt,
    AndAnd,
    OrOr,
    Assign,
    LParen,
    RParen,
    LBrace,
    RBrace,
    Comma,
    Colon,
    Dot,
    At,
    Hash,
    Semi,
    Eof,
    Error
}

struct Token {
    Tok kind;
    string text;
    int start;
    int end;
    int line;
    int column;
}

enum TokenList {
    Nil,
    Cons(Token, TokenList)
}

struct LexResult {
    TokenList tokens;
    DiagList diags;
    bool ok;
    string error_message;
    int error_line;
    int error_column;
}

enum BinOpKind {
    Add,
    Sub,
    Mul,
    Div,
    Eq,
    Ne,
    Lt,
    And,
    Or
}

enum UnOpKind {
    Neg,
    Not
}

enum Expr {
    IntLit(int, int, int),
    BoolLit(bool, int, int),
    StringLit(string, int, int),
    Name(string, int, int),
    Unary(UnOpKind, Expr, int, int),
    BinOp(BinOpKind, Expr, Expr, int, int),
    Assign(string, Expr, int, int),
    Call(string, Expr, int, int),
    Member(Expr, string, int, int),
    ArgNil,
    ArgCons(Expr, Expr)
}

enum Stmt {
    Empty,
    Let(string, Expr, int, int),
    VarDecl(string, string, Expr, bool, int, int),
    AssignStmt(string, Expr, int, int),
    FieldAssign(Expr, string, Expr, int, int),
    ExprStmt(Expr, int, int),
    Print(Expr, int, int),
    Return(Expr, bool, int, int),
    If(Expr, Stmt, Stmt, int, int),
    While(Expr, Stmt, int, int),
    Match(Expr, Stmt, int, int),
    Arm(string, string, Stmt, Stmt),
    ArmEnd,
    Block(Stmt),
    Seq(Stmt, Stmt),
    SeqList(StmtList)
}

enum StmtList {
    StmtNil,
    StmtCons(Stmt, StmtList)
}

enum Decl {
    ActionDecl(string, Decl, string, Stmt, int, int),
    EnumDecl(string, Decl, int, int),
    StructDecl(string, Decl, int, int),
    TopStmt(Stmt),
    ParamNil,
    ParamCons(string, string, Decl),
    FieldNil,
    FieldCons(string, string, Decl),
    VariantNil,
    VariantCons(string, string, Decl),
    DeclNil,
    DeclCons(Decl, Decl)
}

struct Program {
    Decl decls;
    bool ok;
}

enum Severity {
    Error,
    Warning
}

struct Diagnostic {
    string message;
    int line;
    int column;
    Severity severity;
}

enum DiagList {
    Nil,
    Cons(string, int, int, DiagList)
}

struct ParseResult {
    Stmt program;
    DiagList diags;
    bool ok;
}

struct ProgramResult {
    Program program;
    DiagList diags;
    bool ok;
}

struct ExprResult {
    Expr expr;
    TokenList rest;
    DiagList diags;
    bool ok;
}

struct StmtResult {
    Stmt stmt;
    TokenList rest;
    DiagList diags;
    bool ok;
}

struct DeclResult {
    Decl decl;
    TokenList rest;
    DiagList diags;
    bool ok;
}

enum Scope {
    EmptyScope,
    Bind(string, int, Scope)
}

struct ResolveResult {
    Stmt program;
    DiagList diags;
    bool ok;
    int next_id;
}

enum Ty {
    TyInt,
    TyBool,
    TyString,
    TyError
}

enum ScopeTy {
    EmptyScopeTy,
    BindTy(string, Ty, ScopeTy)
}

struct TypeResult {
    DiagList diags;
    bool ok;
    Ty ty;
}

enum Instr {
    Const(int),
    ConstStr(string),
    Add,
    Sub,
    Mul,
    Div,
    CmpEq,
    CmpNe,
    CmpLt,
    Load(int),
    Store(int),
    Label(int),
    Jump(int),
    JumpIfFalse(int),
    Print,
    PrintStr,
    Pop,
    Call(string, int),
    MkEnum(string, int),
    MkStruct(string),
    GetField(string),
    SetField(string),
    JumpIfNotVariant(string, int),
    GetPayload(int),
    Return
}

enum InstrList {
    Nil,
    Cons(Instr, InstrList)
}

enum FuncList {
    FNil,
    FCons(string, int, InstrList, int, FuncList)
}

enum StructEnv {
    SENil,
    SECons(string, string, StructEnv)
}

struct IrModule {
    InstrList code;
    FuncList funcs;
    int label_count;
    int local_count;
}

struct EmitState {
    InstrList code;
    Scope scope;
    int next_local;
    int next_label;
    StructEnv structs;
}

struct RunResult {
    bool ok;
    int last_print;
    bool did_print;
    string last_print_str;
}

enum ValList {
    VNil,
    VCons(int, ValList)
}

enum StrList {
    SNil,
    SCons(string, StrList)
}

enum HeapObj {
    HEmpty,
    HEnum(string, ValList),
    HStruct(string, ValList),
    HString(string)
}

enum HeapList {
    HLNil,
    HLCons(HeapObj, HeapList)
}

struct HeapState {
    HeapList cells;
    int len;
}

enum FuncIndex {
    FIEmpty,
    FINode(string, int, InstrList, int, FuncIndex, FuncIndex)
}

enum LabelArr {
    LANil,
    LACons(InstrList, LabelArr)
}

struct FuncRef {
    bool ok;
    int arity;
    InstrList code;
    int locals;
}

struct FuncRun {
    int value;
    HeapState heap;
    bool did_print;
    int last_print;
    string last_print_str;
}

struct StackHeap {
    ValList stack;
    HeapState heap;
    bool did_print;
    int last_print;
    string last_print_str;
}

struct CompileResult {
    Stmt program;
    bool ok;
}

#include "token.elan"
#include "diagnostic.elan"
#include "lexer.elan"
#include "ast.elan"
#include "parser.elan"
#include "resolver.elan"
#include "typechecker.elan"
#include "ir.elan"
#include "codegen.elan"

