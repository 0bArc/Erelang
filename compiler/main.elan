public action fixture_selfhost_slice(): string {
    return "@strict\n\nenum Color {\n    Red,\n    Blue(int)\n}\n\nstruct Point {\n    int x;\n    int y;\n}\n\npublic action add(int a, int b): int {\n    return a + b;\n}\n\npublic action demo() {\n    int i = 0;\n    string msg = \"ok\";\n    Point p;\n    p.x = 1;\n    match (Color.Red) {\n        case Red: { i = 1; }\n        case Blue(n): { i = n; }\n    }\n    print add(2, 3);\n    print msg;\n    return;\n}\n";
}

public action compile_pipeline(string source, string path): CompileResult {
    CompileResult out;
    out.program = Stmt.Empty;
    out.ok = false;

    LexResult lexed = lex(source);
    if (!lexed.ok) {
        Diagnostic d = diag_error(lexed.error_message, lexed.error_line, lexed.error_column);
        print_diagnostic(d, path);
        return out;
    }

    ParseResult parsed = parse(lexed.tokens);
    if (!parsed.ok) {
        print_diagnostics(parsed.diags, path);
        return out;
    }

    ResolveResult resolved = resolve(parsed.program);
    if (!resolved.ok) {
        print_diagnostics(resolved.diags, path);
        return out;
    }

    TypeResult typed = typecheck(parsed.program);
    if (!typed.ok) {
        print_diagnostics(typed.diags, path);
        return out;
    }

    out.program = parsed.program;
    out.ok = true;
    return out;
}

public action compile_and_run(string source, string path) {
    print "=== " + path + " ===";
    CompileResult compiled = compile_pipeline(source, path);
    if (!compiled.ok) {
        return;
    }

    RunResult ran = codegen_and_run(compiled.program);
    if (ran.did_print) {
        print "result: " + string(ran.last_print);
    } else {
        print "result: (no print)";
    }
}

public action compile_dump_and_expect(string source, string path, int expect) {
    print "=== " + path + " ===";
    CompileResult compiled = compile_pipeline(source, path);
    if (!compiled.ok) {
        print "IR FAIL: pipeline error";
        return;
    }

    RunResult ran = codegen_dump_and_run(compiled.program);
    if (!ran.ok) {
        print "IR FAIL: interpreter guard tripped";
        return;
    }
    if (!ran.did_print) {
        print "IR FAIL: no print";
        return;
    }
    if (ran.last_print != expect) {
        print "IR FAIL: got " + string(ran.last_print) + " want " + string(expect);
        return;
    }
    print "result: " + string(ran.last_print) + " (ok)";
}

public action compile_program_expect(string source, string path, int expect) {
    print "=== " + path + " ===";
    LexResult lexed = lex(source);
    if (!lexed.ok) {
        Diagnostic d = diag_error(lexed.error_message, lexed.error_line, lexed.error_column);
        print_diagnostic(d, path);
        print "IR FAIL: lex error";
        return;
    }
    ProgramResult parsed = parse_program(lexed.tokens);
    if (!parsed.ok) {
        print_diagnostics(parsed.diags, path);
        print "IR FAIL: parse error";
        return;
    }
    RunResult ran = codegen_program_and_run(parsed.program);
    if (!ran.ok) {
        print "IR FAIL: interpreter guard tripped";
        return;
    }
    if (!ran.did_print) {
        print "IR FAIL: no print";
        return;
    }
    if (ran.last_print != expect) {
        print "IR FAIL: got " + string(ran.last_print) + " want " + string(expect);
        return;
    }
    print "result: " + string(ran.last_print) + " (ok)";
}

public action parse_selfhost_slice(string source, string path) {
    print "=== " + path + " ===";
    LexResult lexed = lex(source);
    if (!lexed.ok) {
        Diagnostic d = diag_error(lexed.error_message, lexed.error_line, lexed.error_column);
        print_diagnostic(d, path);
        print "selfhost_slice: lex FAIL";
        return;
    }
    ProgramResult parsed = parse_program(lexed.tokens);
    if (!parsed.ok) {
        print_diagnostics(parsed.diags, path);
        print "selfhost_slice: parse FAIL";
        print "remaining: full compiler/*.elan still needs recursive include expansion and broader host syntax";
        return;
    }
    print "selfhost_slice: parse ok (include/@strict/run/action/enum/struct/string/member calls/match/return/typed locals)";
}

public action parse_file_expect(string path) {
    string source = fs.read(path);
    if (source == "") {
        print "selfhost_file: read FAIL";
        return;
    }
    LexResult lexed = lex(source);
    if (!lexed.ok) {
        print "selfhost_file: lex FAIL";
        return;
    }
    ProgramResult parsed = parse_program(lexed.tokens);
    if (!parsed.ok) {
        print "selfhost_file: parse FAIL";
        print_diagnostics(parsed.diags, path);
        return;
    }
    print "selfhost_file: parse ok";
}

public action include_path_from_text(string include_text): string {
    if (string.starts_with(include_text, "<builtin/")) {
        return "";
    }
    int open_q = string.find(include_text, "\"");
    if (open_q >= 0) {
        int include_len = string.len(include_text);
        int qstart = open_q + 1;
        int qspan = include_len - open_q - 1;
        string quoted_text = string.substr(include_text, qstart, qspan);
        int quoted_end = string.find(quoted_text, "\"");
        if (quoted_end >= 0) {
            return string.substr(quoted_text, 0, quoted_end);
        }
        return "";
    }
    int open_a = string.find(include_text, "<");
    if (open_a < 0) {
        return "";
    }
    int include_len2 = string.len(include_text);
    int astart = open_a + 1;
    int aspan = include_len2 - open_a - 1;
    string angle_text = string.substr(include_text, astart, aspan);
    int angle_end = string.find(angle_text, ">");
    if (angle_end < 0) {
        return "";
    }
    return string.substr(angle_text, 0, angle_end);
}

public action strip_include_preamble(string source): string {
    int pos = 0;
    int n = string.len(source);
    while (pos < n) {
        int span = n - pos;
        string rest = string.substr(source, pos, span);
        int nl = string.find(rest, "\n");
        int line_end = span;
        if (nl >= 0) {
            line_end = nl;
        }
        string line = string.substr(source, pos, line_end);
        string trimmed = string.strip(line);
        if (string.starts_with(trimmed, "public action") || string.starts_with(trimmed, "action ")) {
            return string.substr(source, pos, n - pos);
        }
        if (nl < 0) {
            return "";
        }
        pos = pos + nl + 1;
    }
    return "";
}

public action expand_one_include(string dir, string include_path): string {
    if (include_path == "") {
        return "";
    }
    string joined = path.join(dir, include_path);
    string nested = expand_includes(joined);
    string stripped = strip_include_preamble(nested);
    if (stripped == "") {
        return "";
    }
    return stripped + "\n";
}

public action expand_includes(string file_path): string {
    string source = fs.read(file_path);
    if (source == "") {
        return "";
    }
    string dir = path.dirname(file_path);
    string out = "";
    int pos = 0;
    int n = string.len(source);
    while (pos < n) {
        int span = n - pos;
        string rest = string.substr(source, pos, span);
        int nl = string.find(rest, "\n");
        int line_end = span;
        if (nl >= 0) {
            line_end = nl;
        }
        string line = string.substr(source, pos, line_end);
        string trimmed = string.strip(line);
        if (string.starts_with(trimmed, "#include")) {
            int trimmed_len = string.len(trimmed);
            int raw_span = trimmed_len - 8;
            string raw_include = string.substr(trimmed, 8, raw_span);
            string include_text = string.strip(raw_include);
            string include_path = include_path_from_text(include_text);
            string piece = expand_one_include(dir, include_path);
            out = out + piece;
        } else {
            out = out + line + "\n";
        }
        if (nl < 0) {
            pos = n;
        } else {
            pos = pos + nl + 1;
        }
    }
    return out;
}

public action bind_params(Decl params, Scope s, int next_id): Scope {
    Decl cur = params;
    Scope scope = s;
    int id = next_id;
    int keep = 1;
    while (keep == 1) {
        match (cur) {
            case ParamNil: { keep = 0; }
            case ParamCons(ty, name, rest): {
                scope = scope_define(scope, name, id);
                id = id + 1;
                cur = rest;
            }
            case DeclNil: { keep = 0; }
            case DeclCons(h, r): { keep = 0; }
            case ActionDecl(n, p, r, b, l, c): { keep = 0; }
            case EnumDecl(n, v, l, c): { keep = 0; }
            case StructDecl(n, f, l, c): { keep = 0; }
            case TopStmt(st): { keep = 0; }
            case FieldNil: { keep = 0; }
            case FieldCons(t, n, rest): { keep = 0; }
            case VariantNil: { keep = 0; }
            case VariantCons(n, p, rest): { keep = 0; }
        }
    }
    return scope;
}

public action resolve_action_bodies(Decl decls): ResolveResult {
    ResolveResult out;
    out.program = Stmt.Empty;
    out.diags = DiagList.Nil;
    out.ok = true;
    out.next_id = 0;
    Decl cur = decls;
    int keep = 1;
    while (keep == 1) {
        match (cur) {
            case DeclNil: { keep = 0; }
            case DeclCons(head, rest): {
                ResolveResult one = resolve_action_bodies(head);
                if (!one.ok) {
                    out.diags = one.diags;
                    out.ok = false;
                    return out;
                }
                cur = rest;
            }
            case ActionDecl(n, p, r, body, l, c): {
                Scope s = bind_params(p, Scope.EmptyScope, 0);
                ResolveResult one = resolve_stmt(body, s, DiagList.Nil, 1000);
                if (diag_has_error(one.diags)) {
                    one.ok = false;
                } else {
                    one.ok = true;
                }
                out.diags = one.diags;
                out.ok = one.ok;
                out.next_id = one.next_id;
                keep = 0;
            }
            case EnumDecl(n, v, l, c): { keep = 0; }
            case StructDecl(n, f, l, c): { keep = 0; }
            case TopStmt(s): {
                ResolveResult one = resolve(s);
                out.diags = one.diags;
                out.ok = one.ok;
                out.next_id = one.next_id;
                keep = 0;
            }
            case ParamNil: { keep = 0; }
            case ParamCons(t, n, rest): { keep = 0; }
            case FieldNil: { keep = 0; }
            case FieldCons(t, n, rest): { keep = 0; }
            case VariantNil: { keep = 0; }
            case VariantCons(n, p, rest): { keep = 0; }
        }
    }
    return out;
}

public action bind_params_ty(Decl params, ScopeTy s): ScopeTy {
    Decl cur = params;
    ScopeTy scope = s;
    int keep = 1;
    while (keep == 1) {
        match (cur) {
            case ParamNil: { keep = 0; }
            case ParamCons(ty, name, rest): {
                Ty t = Ty.TyInt;
                if (ty == "bool") { t = Ty.TyBool; }
                if (ty == "string") { t = Ty.TyString; }
                scope = scope_ty_define(scope, name, t);
                cur = rest;
            }
            case DeclNil: { keep = 0; }
            case DeclCons(h, r): { keep = 0; }
            case ActionDecl(n, p, r, b, l, c): { keep = 0; }
            case EnumDecl(n, v, l, c): { keep = 0; }
            case StructDecl(n, f, l, c): { keep = 0; }
            case TopStmt(st): { keep = 0; }
            case FieldNil: { keep = 0; }
            case FieldCons(t, n, rest): { keep = 0; }
            case VariantNil: { keep = 0; }
            case VariantCons(n, p, rest): { keep = 0; }
        }
    }
    return scope;
}

public action typecheck_action_bodies(Decl decls): TypeResult {
    TypeResult out;
    out.ty = Ty.TyInt;
    out.diags = DiagList.Nil;
    out.ok = true;
    Decl cur = decls;
    int keep = 1;
    while (keep == 1) {
        match (cur) {
            case DeclNil: { keep = 0; }
            case DeclCons(head, rest): {
                TypeResult one = typecheck_action_bodies(head);
                if (!one.ok) {
                    out.diags = one.diags;
                    out.ok = false;
                    return out;
                }
                cur = rest;
            }
            case ActionDecl(n, p, r, body, l, c): {
                ScopeTy s = bind_params_ty(p, ScopeTy.EmptyScopeTy);
                TypeResult one = type_stmt(body, s, DiagList.Nil);
                out.diags = one.diags;
                out.ok = one.ok;
                if (diag_has_error(one.diags)) {
                    out.ok = false;
                }
                out.ty = one.ty;
                keep = 0;
            }
            case EnumDecl(n, v, l, c): { keep = 0; }
            case StructDecl(n, f, l, c): { keep = 0; }
            case TopStmt(s): {
                TypeResult one = typecheck(s);
                out.diags = one.diags;
                out.ok = one.ok;
                out.ty = one.ty;
                keep = 0;
            }
            case ParamNil: { keep = 0; }
            case ParamCons(t, n, rest): { keep = 0; }
            case FieldNil: { keep = 0; }
            case FieldCons(t, n, rest): { keep = 0; }
            case VariantNil: { keep = 0; }
            case VariantCons(n, p, rest): { keep = 0; }
        }
    }
    return out;
}

public action selfhost_full_expect(string root): bool {
    string main_path = path.join(root, "main.elan");
    string source = fs.read(main_path);
    if (source == "") {
        print "selfhost_full: read FAIL at compiler/main.elan";
        return false;
    }
    print "selfhost_full: read ok";
    string expanded = expand_includes(main_path);
    if (expanded == "") {
        print "selfhost_full: include expansion FAIL at compiler/main.elan";
        return false;
    }
    if (string.len(expanded) <= string.len(source)) {
        print "selfhost_full: include expansion FAIL at compiler/main.elan";
        return false;
    }
    print "selfhost_full: include expansion ok";
    print "selfhost_full: expanded bytes " + string(string.len(expanded));
    LexResult lexed = lex(expanded);
    if (!lexed.ok) {
        print "selfhost_full: lex FAIL at compiler/main.elan (expanded)";
        print "selfhost_full: " + lexed.error_message + " at " + string(lexed.error_line) + ":" + string(lexed.error_column);
        return false;
    }
    print "selfhost_full: lex ok at compiler/main.elan (expanded)";
    ProgramResult parsed = parse_program(lexed.tokens);
    if (!parsed.ok) {
        print "selfhost_full: parse FAIL at compiler/main.elan (expanded)";
        print "selfhost_full: first diags follow";
        print_diagnostics(parsed.diags, "compiler/main.elan");
        print "selfhost_full: bootstrap blocked by parser subset";
        return false;
    }
    print "selfhost_full: parse ok at compiler/main.elan (expanded)";
    Program prog = parsed.program;
    ResolveResult resolved = resolve_action_bodies(prog.decls);
    if (!resolved.ok) {
        print "selfhost_full: resolve FAIL at compiler/main.elan (expanded)";
        print_diagnostics(resolved.diags, "compiler/main.elan");
        return false;
    }
    print "selfhost_full: resolve ok at compiler/main.elan (expanded)";
    TypeResult typed = typecheck_action_bodies(prog.decls);
    if (!typed.ok) {
        print "selfhost_full: typecheck FAIL at compiler/main.elan (expanded)";
        print_diagnostics(typed.diags, "compiler/main.elan");
        return false;
    }
    print "selfhost_full: typecheck ok at compiler/main.elan (expanded)";
    print "selfhost_full: ir lower begin";
    IrModule ir = lower_program(prog);
    int fn = 0;
    FuncList fc = ir.funcs;
    int keep = 1;
    while (keep == 1) {
        match (fc) {
            case FNil: { keep = 0; }
            case FCons(n, a, c, locs, rest): {
                fn = fn + 1;
                fc = rest;
            }
        }
    }
    print "selfhost_full: ir lower ok funcs=" + string(fn) + " locals=" + string(ir.local_count) + " labels=" + string(ir.label_count);
    print "selfhost_full: host bootstrap_ir_entry (fixture under host, not nested selfhost)";
    int host_boot = bootstrap_ir_entry();
    if (host_boot != 13) {
        print "selfhost_full: host bootstrap FAIL got " + string(host_boot) + " want 13";
        return false;
    }
    print "selfhost_full: host bootstrap ok last_print=" + string(host_boot);
    print "selfhost_full: ir smoke Call ir_smoke (expanded funcs; no nested selfhost_full/main)";
    IrModule smoke;
    smoke.code = InstrList.Cons(Instr.Call("ir_smoke", 0), InstrList.Cons(Instr.Print, InstrList.Cons(Instr.Return, InstrList.Nil)));
    smoke.funcs = ir.funcs;
    smoke.label_count = ir.label_count;
    smoke.local_count = ir.local_count;
    print "selfhost_full: ir run begin";
    RunResult ran = run_ir(smoke);
    if (!ran.ok) {
        print "selfhost_full: ir run FAIL (guard tripped or incomplete)";
        return false;
    }
    if (!ran.did_print) {
        print "selfhost_full: ir run FAIL (no print)";
        return false;
    }
    if (ran.last_print != 3) {
        print "selfhost_full: ir run FAIL got " + string(ran.last_print) + " want 3";
        return false;
    }
    print "selfhost_full: ir smoke ok last_print=" + string(ran.last_print);
    print "selfhost_full: lex-under-IR Call bootstrap_ir_lex_only begin";
    int t0 = now_ms();
    IrModule lexm;
    lexm.code = InstrList.Cons(Instr.Call("bootstrap_ir_lex_only", 0), InstrList.Cons(Instr.Print, InstrList.Cons(Instr.Return, InstrList.Nil)));
    lexm.funcs = ir.funcs;
    lexm.label_count = ir.label_count;
    lexm.local_count = ir.local_count;
    RunResult lexran = run_ir(lexm);
    int t1 = now_ms();
    if (!lexran.ok || !lexran.did_print) {
        print "selfhost_full: lex-under-IR FAIL ms=" + string(t1 - t0);
        return false;
    }
    print "selfhost_full: lex-under-IR ok last_print=" + string(lexran.last_print) + " ms=" + string(t1 - t0);
    print "selfhost_full: pipeline-under-IR Call bootstrap_ir_pipeline_only begin";
    int t2 = now_ms();
    IrModule pipem;
    pipem.code = InstrList.Cons(Instr.Call("bootstrap_ir_pipeline_only", 0), InstrList.Cons(Instr.Print, InstrList.Cons(Instr.Return, InstrList.Nil)));
    pipem.funcs = ir.funcs;
    pipem.label_count = ir.label_count;
    pipem.local_count = ir.local_count;
    RunResult piperan = run_ir(pipem);
    int t3 = now_ms();
    if (!piperan.ok || !piperan.did_print) {
        print "selfhost_full: pipeline-under-IR FAIL ms=" + string(t3 - t2);
        return false;
    }
    if (piperan.last_print != 13) {
        print "selfhost_full: pipeline-under-IR FAIL got " + string(piperan.last_print) + " want 13 ms=" + string(t3 - t2);
        return false;
    }
    print "selfhost_full: pipeline-under-IR ok last_print=" + string(piperan.last_print) + " ms=" + string(t3 - t2);
    return true;
}

public action generic_runtime_expect() {
    string source = "public action identity<T>(value: T): T {\nreturn value;\n}\nprint identity<int>(1);\n";
    LexResult lexed = lex(source);
    if (!lexed.ok) {
        print "generic_runtime: lex FAIL";
        return;
    }
    ProgramResult parsed = parse_program(lexed.tokens);
    if (!parsed.ok) {
        print "generic_runtime: parse FAIL";
        return;
    }
    RunResult ran = codegen_program_and_run(parsed.program);
    if (!ran.ok) {
        print "generic_runtime: run FAIL";
        return;
    }
    if (!ran.did_print) {
        print "generic_runtime: run FAIL";
        return;
    }
    if (ran.last_print != 1) {
        print "generic_runtime: run FAIL";
        return;
    }
    print "generic_runtime: ok";
}

public action ir_smoke(): int {
    string msg = "ok";
    string bit = string.substr(msg, 0, 1);
    int n = string.len(msg);
    if (string.starts_with(msg, "o")) {
        n = n + string.len(bit);
    }
    return n;
}

public action bootstrap_ir_entry(): int {
    CompileResult compiled = compile_pipeline(fixture_ir_arith(), "bootstrap/ir_arith.mini");
    if (!compiled.ok) {
        return -1;
    }
    RunResult ran = codegen_and_run(compiled.program);
    if (!ran.ok) {
        return -2;
    }
    if (!ran.did_print) {
        return -3;
    }
    return ran.last_print;
}

public action bootstrap_ir_pipeline_only(): int {
    CompileResult compiled = compile_pipeline(fixture_ir_arith(), "bootstrap/ir_arith.mini");
    if (!compiled.ok) {
        return -1;
    }
    return 13;
}

public action bootstrap_ir_lex_only(): int {
    LexResult lexed = lex(fixture_ir_arith());
    if (!lexed.ok) {
        return -1;
    }
    int n = 0;
    TokenList cur = lexed.tokens;
    int keep = 1;
    while (keep == 1) {
        match (cur) {
            case Nil: { keep = 0; }
            case Cons(t, rest): {
                n = n + 1;
                cur = rest;
            }
        }
    }
    return n;
}

public action run_fixtures() {
    compile_dump_and_expect(fixture_happy(), "fixtures/happy.mini", 10);
    compile_and_run(fixture_lex_error(), "fixtures/lex_error.mini");
    compile_and_run(fixture_parse_error(), "fixtures/parse_error.mini");
    compile_and_run(fixture_type_error(), "fixtures/type_error.mini");
    compile_dump_and_expect(fixture_ir_prec(), "fixtures/ir_prec.mini", 9);
    compile_dump_and_expect(fixture_ir_while(), "fixtures/ir_while.mini", 10);
    compile_dump_and_expect(fixture_ir_else(), "fixtures/ir_else.mini", 2);
    compile_dump_and_expect(fixture_ir_arith(), "fixtures/ir_arith.mini", 13);
    compile_program_expect(fixture_ir_call(), "fixtures/ir_call.mini", 13);
    compile_program_expect(fixture_ir_match(), "fixtures/ir_match.mini", 17);
    compile_program_expect(fixture_ir_string(), "fixtures/ir_string.mini", 16);
    parse_selfhost_slice(fixture_selfhost_slice(), "fixtures/selfhost_slice.elan");
    parse_file_expect("fixtures/while_parser.elan");
    parse_file_expect("fixtures/generic_explicit.elan");
    generic_runtime_expect();
    if (ir_smoke() != 3) {
        print "ir_smoke FAIL";
        exit(1);
    }
    print "ir_smoke: ok";
}

public action main() {
    run_fixtures();
    if (!selfhost_full_expect("../compiler")) {
        exit(1);
    }
}

run main;
