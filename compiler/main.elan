@strict

#include <builtin/fs> as fs
#include <builtin/path> as path

enum Tok {
    Ident,
    Keyword,
    Number,
    String,
    Plus,
    Minus,
    Star,
    Slash,
    EqEq,
    BangEq,
    Bang,
    Lt,
    AndAnd,
    OrOr,
    Assign,
    LParen,
    RParen,
    LBrace,
    RBrace,
    Comma,
    Colon,
    Dot,
    At,
    Hash,
    Semi,
    Eof,
    Error
}

struct Token {
    Tok kind;
    string text;
    int start;
    int end;
    int line;
    int column;
}

enum TokenList {
    Nil,
    Cons(Token, TokenList)
}

struct LexResult {
    TokenList tokens;
    DiagList diags;
    bool ok;
    string error_message;
    int error_line;
    int error_column;
}

enum BinOpKind {
    Add,
    Sub,
    Mul,
    Div,
    Eq,
    Ne,
    Lt,
    And,
    Or
}

enum UnOpKind {
    Neg,
    Not
}

enum Expr {
    IntLit(int, int, int),
    BoolLit(bool, int, int),
    StringLit(string, int, int),
    Name(string, int, int),
    Unary(UnOpKind, Expr, int, int),
    BinOp(BinOpKind, Expr, Expr, int, int),
    Assign(string, Expr, int, int),
    Call(string, Expr, int, int),
    Member(Expr, string, int, int),
    ArgNil,
    ArgCons(Expr, Expr)
}

enum Stmt {
    Empty,
    Let(string, Expr, int, int),
    VarDecl(string, string, Expr, bool, int, int),
    AssignStmt(string, Expr, int, int),
    FieldAssign(Expr, string, Expr, int, int),
    ExprStmt(Expr, int, int),
    Print(Expr, int, int),
    Return(Expr, bool, int, int),
    If(Expr, Stmt, Stmt, int, int),
    While(Expr, Stmt, int, int),
    Match(Expr, Stmt, int, int),
    Arm(string, string, Stmt, Stmt),
    ArmEnd,
    Block(Stmt),
    Seq(Stmt, Stmt),
    SeqList(StmtList)
}

enum StmtList {
    StmtNil,
    StmtCons(Stmt, StmtList)
}

enum Decl {
    ActionDecl(string, Decl, string, Stmt, int, int),
    EnumDecl(string, Decl, int, int),
    StructDecl(string, Decl, int, int),
    TopStmt(Stmt),
    ParamNil,
    ParamCons(string, string, Decl),
    FieldNil,
    FieldCons(string, string, Decl),
    VariantNil,
    VariantCons(string, string, Decl),
    DeclNil,
    DeclCons(Decl, Decl)
}

struct Program {
    Decl decls;
    bool ok;
}

enum Severity {
    Error,
    Warning
}

struct Diagnostic {
    string message;
    int line;
    int column;
    Severity severity;
}

enum DiagList {
    Nil,
    Cons(string, int, int, DiagList)
}

struct ParseResult {
    Stmt program;
    DiagList diags;
    bool ok;
}

struct ProgramResult {
    Program program;
    DiagList diags;
    bool ok;
}

struct ExprResult {
    Expr expr;
    TokenList rest;
    DiagList diags;
    bool ok;
}

struct StmtResult {
    Stmt stmt;
    TokenList rest;
    DiagList diags;
    bool ok;
}

struct DeclResult {
    Decl decl;
    TokenList rest;
    DiagList diags;
    bool ok;
}

enum Scope {
    EmptyScope,
    Bind(string, int, Scope)
}

struct ResolveResult {
    Stmt program;
    DiagList diags;
    bool ok;
    int next_id;
}

enum Ty {
    TyInt,
    TyBool,
    TyString,
    TyError
}

enum ScopeTy {
    EmptyScopeTy,
    BindTy(string, Ty, ScopeTy)
}

struct TypeResult {
    DiagList diags;
    bool ok;
    Ty ty;
}

enum Instr {
    Const(int),
    ConstStr(string),
    Add,
    Sub,
    Mul,
    Div,
    CmpEq,
    CmpNe,
    CmpLt,
    Load(int),
    Store(int),
    Label(int),
    Jump(int),
    JumpIfFalse(int),
    Print,
    PrintStr,
    Pop,
    Call(string, int),
    MkEnum(string, int),
    MkStruct(string),
    GetField(string),
    SetField(string),
    JumpIfNotVariant(string, int),
    GetPayload(int),
    Return
}

enum InstrList {
    Nil,
    Cons(Instr, InstrList)
}

enum FuncList {
    FNil,
    FCons(string, int, InstrList, int, FuncList)
}

enum StructEnv {
    SENil,
    SECons(string, string, StructEnv)
}

struct IrModule {
    InstrList code;
    FuncList funcs;
    int label_count;
    int local_count;
}

struct EmitState {
    InstrList code;
    Scope scope;
    int next_local;
    int next_label;
    StructEnv structs;
}

struct RunResult {
    bool ok;
    int last_print;
    bool did_print;
    string last_print_str;
}

enum ValList {
    VNil,
    VCons(int, ValList)
}

enum StrList {
    SNil,
    SCons(string, StrList)
}

enum HeapObj {
    HEmpty,
    HEnum(string, ValList),
    HStruct(string, ValList),
    HString(string)
}

enum HeapList {
    HLNil,
    HLCons(HeapObj, HeapList)
}

struct HeapState {
    HeapList cells;
    int len;
}

enum FuncIndex {
    FIEmpty,
    FINode(string, int, InstrList, int, FuncIndex, FuncIndex)
}

enum LabelArr {
    LANil,
    LACons(InstrList, LabelArr)
}

struct FuncRef {
    bool ok;
    int arity;
    InstrList code;
    int locals;
}

struct FuncRun {
    int value;
    HeapState heap;
    bool did_print;
    int last_print;
    string last_print_str;
}

struct StackHeap {
    ValList stack;
    HeapState heap;
    bool did_print;
    int last_print;
    string last_print_str;
}

struct CompileResult {
    Stmt program;
    bool ok;
}

#include "token.elan"
#include "diagnostic.elan"
#include "lexer.elan"
#include "ast.elan"
#include "parser.elan"
#include "resolver.elan"
#include "typechecker.elan"
#include "ir.elan"
#include "codegen.elan"

public action fixture_happy(): string {
    return "let x = 1 + 2 * 3;\nlet n = 0;\nwhile (n < 3) {\n  n = n + 1;\n}\nif (x < 10) {\n  x = x + n;\n} else {\n  x = 0;\n}\nprint x;\n";
}

public action fixture_lex_error(): string {
    return "let x = 1 $ 2;\nprint x;\n";
}

public action fixture_parse_error(): string {
    return "let x = (1 + ;\nprint x;\n";
}

public action fixture_type_error(): string {
    return "let x = 1;\nprint x + (1 < 2);\n";
}

public action fixture_ir_prec(): string {
    return "print 1 + 2 * 3;\nprint (1 + 2) * 3;\n";
}

public action fixture_ir_while(): string {
    return "let s = 0;\nlet i = 1;\nwhile (i < 5) {\n  s = s + i;\n  i = i + 1;\n}\nprint s;\n";
}

public action fixture_ir_else(): string {
    return "let x = 5;\nif (x < 3) {\n  print 1;\n} else {\n  print 2;\n}\n";
}

public action fixture_ir_arith(): string {
    return "let a = 20 - 8 / 2;\nlet b = a - 3;\nprint b;\n";
}

public action fixture_ir_call(): string {
    return "public action add(int a, int b): int {\n  return a + b;\n}\nprint add(6, 7);\nprint \"hi\";\n";
}

public action fixture_ir_match(): string {
    return "enum Color {\n    Red,\n    Blue(int)\n}\n\nstruct Point {\n    int x;\n    int y;\n}\n\nPoint p;\np.x = 3;\np.y = 4;\nint s = 0;\nmatch (Color.Blue(10)) {\n    case Red: { s = 1; }\n    case Blue(n): { s = n + p.x; }\n}\nmatch (Color.Red) {\n    case Red: { s = s + p.y; }\n    case Blue(n): { s = s + n; }\n}\nprint s;\n";
}

public action fixture_ir_string(): string {
    return "enum Color {\n    Red,\n    Blue(int)\n}\n\nstruct Point {\n    int x;\n    int y;\n}\n\nPoint p;\np.x = 3;\nstring msg = \"ok\";\nstring first = string.substr(msg, 0, 1);\nint n = string.len(msg);\nmatch (Color.Blue(10)) {\n    case Red: { n = 0; }\n    case Blue(v): { n = n + v + p.x; }\n}\nif (string.starts_with(msg, \"o\")) {\n    n = n + string.len(first);\n}\nprint n;\n";
}

public action fixture_program_slice(): string {
    return "@strict\n\nenum Color {\n    Red,\n    Blue(int)\n}\n\nstruct Point {\n    int x;\n    int y;\n}\n\npublic action add(int a, int b): int {\n    return a + b;\n}\n\npublic action demo() {\n    int i = 0;\n    string msg = \"ok\";\n    Point p;\n    p.x = 1;\n    match (Color.Red) {\n        case Red: { i = 1; }\n        case Blue(n): { i = n; }\n    }\n    print add(2, 3);\n    print msg;\n    return;\n}\n";
}

public action compile_pipeline(string source, string path): CompileResult {
    CompileResult out;
    out.program = Stmt.Empty;
    out.ok = false;

    LexResult lexed = lex(source);
    if (!lexed.ok) {
        Diagnostic d = diag_error(lexed.error_message, lexed.error_line, lexed.error_column);
        print_diagnostic(d, path);
        return out;
    }

    ParseResult parsed = parse(lexed.tokens);
    if (!parsed.ok) {
        print_diagnostics(parsed.diags, path);
        return out;
    }

    ResolveResult resolved = resolve(parsed.program);
    if (!resolved.ok) {
        print_diagnostics(resolved.diags, path);
        return out;
    }

    TypeResult typed = typecheck(parsed.program);
    if (!typed.ok) {
        print_diagnostics(typed.diags, path);
        return out;
    }

    out.program = parsed.program;
    out.ok = true;
    return out;
}

public action compile_and_run(string source, string path) {
    print "=== " + path + " ===";
    CompileResult compiled = compile_pipeline(source, path);
    if (!compiled.ok) {
        return;
    }

    RunResult ran = codegen_and_run(compiled.program);
    if (ran.did_print) {
        print "result: " + string(ran.last_print);
    } else {
        print "result: (no print)";
    }
}

public action compile_dump_and_expect(string source, string path, int expect) {
    print "=== " + path + " ===";
    CompileResult compiled = compile_pipeline(source, path);
    if (!compiled.ok) {
        print "IR FAIL: pipeline error";
        return;
    }

    RunResult ran = codegen_dump_and_run(compiled.program);
    if (!ran.ok) {
        print "IR FAIL: interpreter guard tripped";
        return;
    }
    if (!ran.did_print) {
        print "IR FAIL: no print";
        return;
    }
    if (ran.last_print != expect) {
        print "IR FAIL: got " + string(ran.last_print) + " want " + string(expect);
        return;
    }
    print "result: " + string(ran.last_print) + " (ok)";
}

public action compile_program_expect(string source, string path, int expect) {
    print "=== " + path + " ===";
    LexResult lexed = lex(source);
    if (!lexed.ok) {
        Diagnostic d = diag_error(lexed.error_message, lexed.error_line, lexed.error_column);
        print_diagnostic(d, path);
        print "IR FAIL: lex error";
        return;
    }
    ProgramResult parsed = parse_program(lexed.tokens);
    if (!parsed.ok) {
        print_diagnostics(parsed.diags, path);
        print "IR FAIL: parse error";
        return;
    }
    RunResult ran = codegen_program_and_run(parsed.program);
    if (!ran.ok) {
        print "IR FAIL: interpreter guard tripped";
        return;
    }
    if (!ran.did_print) {
        print "IR FAIL: no print";
        return;
    }
    if (ran.last_print != expect) {
        print "IR FAIL: got " + string(ran.last_print) + " want " + string(expect);
        return;
    }
    print "result: " + string(ran.last_print) + " (ok)";
}

public action parse_program_slice(string source, string path) {
    print "=== " + path + " ===";
    LexResult lexed = lex(source);
    if (!lexed.ok) {
        Diagnostic d = diag_error(lexed.error_message, lexed.error_line, lexed.error_column);
        print_diagnostic(d, path);
        print "program_slice: lex FAIL";
        return;
    }
    ProgramResult parsed = parse_program(lexed.tokens);
    if (!parsed.ok) {
        print_diagnostics(parsed.diags, path);
        print "program_slice: parse FAIL";
        return;
    }
    print "program_slice: parse ok (include/@strict/run/action/enum/struct/string/member calls/match/return/typed locals)";
}

public action parse_file_expect(string path) {
    string source = fs.read(path);
    if (source == "") {
        print "parse_file: read FAIL";
        return;
    }
    LexResult lexed = lex(source);
    if (!lexed.ok) {
        print "parse_file: lex FAIL";
        return;
    }
    ProgramResult parsed = parse_program(lexed.tokens);
    if (!parsed.ok) {
        print "parse_file: parse FAIL";
        print_diagnostics(parsed.diags, path);
        return;
    }
    print "parse_file: parse ok";
}

public action generic_runtime_expect() {
    string source = "public action identity<T>(value: T): T {\nreturn value;\n}\nprint identity<int>(1);\n";
    LexResult lexed = lex(source);
    if (!lexed.ok) {
        print "generic_runtime: lex FAIL";
        return;
    }
    ProgramResult parsed = parse_program(lexed.tokens);
    if (!parsed.ok) {
        print "generic_runtime: parse FAIL";
        return;
    }
    RunResult ran = codegen_program_and_run(parsed.program);
    if (!ran.ok) {
        print "generic_runtime: run FAIL";
        return;
    }
    if (!ran.did_print) {
        print "generic_runtime: run FAIL";
        return;
    }
    if (ran.last_print != 1) {
        print "generic_runtime: run FAIL";
        return;
    }
    print "generic_runtime: ok";
}

public action ir_smoke(): int {
    string msg = "ok";
    string bit = string.substr(msg, 0, 1);
    int n = string.len(msg);
    if (string.starts_with(msg, "o")) {
        n = n + string.len(bit);
    }
    return n;
}

public action run_fixtures() {
    compile_dump_and_expect(fixture_happy(), "fixtures/happy.mini", 10);
    compile_and_run(fixture_lex_error(), "fixtures/lex_error.mini");
    compile_and_run(fixture_parse_error(), "fixtures/parse_error.mini");
    compile_and_run(fixture_type_error(), "fixtures/type_error.mini");
    compile_dump_and_expect(fixture_ir_prec(), "fixtures/ir_prec.mini", 9);
    compile_dump_and_expect(fixture_ir_while(), "fixtures/ir_while.mini", 10);
    compile_dump_and_expect(fixture_ir_else(), "fixtures/ir_else.mini", 2);
    compile_dump_and_expect(fixture_ir_arith(), "fixtures/ir_arith.mini", 13);
    compile_program_expect(fixture_ir_call(), "fixtures/ir_call.mini", 13);
    compile_program_expect(fixture_ir_match(), "fixtures/ir_match.mini", 17);
    compile_program_expect(fixture_ir_string(), "fixtures/ir_string.mini", 16);
    parse_program_slice(fixture_program_slice(), "fixtures/program_slice.elan");
    parse_file_expect("fixtures/while_parser.elan");
    parse_file_expect("fixtures/generic_explicit.elan");
    generic_runtime_expect();
    if (ir_smoke() != 3) {
        print "ir_smoke FAIL";
        exit(1);
    }
    print "ir_smoke: ok";
}

public action main() {
    run_fixtures();
}

run main;
