{
  "name": "erelang-language",
  "displayName": "Erelang Language",
  "publisher": "localdev",
  "description": "LSP, DAP debugger, and syntax highlighting for Erelang (.elan)",
  "version": "0.0.34",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:erelang",
    "onLanguage:erelangManifest",
    "onLanguage:erelangCore",
    "onCommand:erelang.debugCompletionContext",
    "onDebugResolve:erelang"
  ],
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "contributes": {
    "commands": [
      {
        "command": "erelang.debugCompletionContext",
        "title": "Erelang: Debug Completion Context",
        "category": "Erelang"
      }
    ],
    "configurationDefaults": {
      "[erelang]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.acceptSuggestionOnEnter": "smart",
        "editor.wordBasedSuggestions": "off",
        "editor.links": false,
        "editor.codeActionsOnSave": {},
        "editor.formatOnSave": false,
        "editor.semanticHighlighting.enabled": false
      }
    },
    "semanticTokenTypes": [
      {
        "id": "function",
        "superType": "function",
        "description": "Action and function names"
      },
      {
        "id": "method",
        "superType": "method",
        "description": "Member method calls"
      },
      {
        "id": "class",
        "superType": "class",
        "description": "Entity, struct, enum, and type names"
      },
      {
        "id": "parameter",
        "superType": "parameter",
        "description": "Function and foreach parameters"
      },
      {
        "id": "variable",
        "superType": "variable",
        "description": "Local and global variables"
      },
      {
        "id": "property",
        "superType": "property",
        "description": "Fields and member properties"
      },
      {
        "id": "enumMember",
        "superType": "enumMember",
        "description": "Enum member names"
      },
      {
        "id": "number",
        "superType": "number",
        "description": "Numeric literals"
      },
      {
        "id": "string",
        "superType": "string",
        "description": "String literals"
      },
      {
        "id": "keyword",
        "superType": "keyword",
        "description": "Language constants such as true/false/null"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "declaration",
        "description": "Name at its declaration site"
      },
      {
        "id": "defaultLibrary",
        "description": "Built-in or standard-library symbol"
      },
      {
        "id": "readonly",
        "description": "Constant or immutable binding"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "function": ["entity.name.function", "entity.name.function.erelang"],
          "function.declaration": ["entity.name.function", "entity.name.function.erelang"],
          "function.defaultLibrary": ["support.function", "support.function.builtin.erelang"],
          "method": ["entity.name.function.member", "entity.name.function.member.erelang"],
          "method.defaultLibrary": ["support.function", "support.function.builtin.erelang"],
          "class": ["entity.name.type", "entity.name.class", "entity.name.type.erelang"],
          "class.declaration": ["entity.name.type", "entity.name.class", "entity.name.type.erelang"],
          "class.defaultLibrary": ["support.type", "storage.type.erelang"],
          "parameter": ["variable.parameter", "variable.parameter.erelang"],
          "parameter.declaration": ["variable.parameter", "variable.parameter.erelang"],
          "variable": ["variable.other", "variable.other.erelang"],
          "variable.declaration": ["variable.other", "variable.other.erelang"],
          "variable.readonly": ["variable.other.constant", "variable.other.constant.erelang"],
          "property": ["variable.other.property", "variable.other.property.erelang"],
          "property.declaration": ["variable.other.property", "variable.other.property.erelang"],
          "enumMember": ["variable.other.constant", "constant.other", "variable.other.enummember", "variable.other.constant.erelang"],
          "enumMember.declaration": ["variable.other.constant", "constant.other", "variable.other.enummember", "variable.other.constant.erelang"],
          "number": ["constant.numeric", "constant.numeric.erelang"],
          "string": ["string", "string.quoted.double.erelang"],
          "keyword": ["constant.language", "constant.language.erelang"],
          "keyword.readonly": ["constant.language", "constant.language.erelang"]
        }
      }
    ],
    "configuration": {
      "title": "Erelang",
      "properties": {
        "erelang.autoSuggestIdentifiers": {
          "type": "boolean",
          "default": false,
          "description": "Retrigger IntelliSense while typing #include paths. Off by default; include completions also trigger on #, <, \", / and space."
        },
        "erelang.debugCompletion": {
          "type": "boolean",
          "default": false,
          "description": "Write completion-branch debug traces to the Erelang Language Debug output channel."
        },
        "erelang.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to erelang.exe (for LSP --check and DAP). Empty = search build/bin and PATH."
        }
      }
    },
    "languages": [
      {
        "id": "erelang",
        "aliases": [
          "Erelang",
          "erelang"
        ],
        "extensions": [
          ".elan"
        ],
        "icon": {
          "light": "./icons/erelang-light.png",
          "dark": "./icons/erelang-dark.png"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "erelangManifest",
        "aliases": [
          "Erelang Manifest"
        ],
        "extensions": [
          ".elp"
        ],
        "configuration": "./language-configuration-manifest.json"
      },
      {
        "id": "erelangCore",
        "aliases": [
          "Erelang Core"
        ],
        "extensions": [
          ".core"
        ],
        "configuration": "./language-configuration-core.json"
      }
    ],
    "grammars": [
      {
        "language": "erelang",
        "scopeName": "source.erelang",
        "path": "./syntaxes/erevos.tmLanguage.json"
      },
      {
        "language": "erelangManifest",
        "scopeName": "text.erelang.manifest",
        "path": "./syntaxes/erevos-manifest.tmLanguage.json"
      },
      {
        "language": "erelangCore",
        "scopeName": "source.erelang.core",
        "path": "./syntaxes/erevos-core.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "erelang",
        "path": "./snippets/erevos.code-snippets"
      }
    ],
    "debuggers": [
      {
        "type": "erelang",
        "label": "Erelang",
        "languages": ["erelang"],
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to .elan script",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory",
                "default": "${workspaceFolder}"
              },
              "erelangPath": {
                "type": "string",
                "description": "Optional path to erelang.exe",
                "default": ""
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop on first statement (use a breakpoint)",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "erelang",
            "request": "launch",
            "name": "Erelang: Launch current file",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Erelang: Launch",
            "description": "Launch an .elan script with breakpoints",
            "body": {
              "type": "erelang",
              "request": "launch",
              "name": "Erelang: Launch ${1:file}",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tools/build-erelang-icon.ps1",
    "vscode:prepublish": "npm run build:icon && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository -o erelang_language.vsix",
    "test": "npm run compile && node --test test/*.test.js",
    "postinstall": "node ./node_modules/vscode/bin/install"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.5.4",
    "vsce": "^2.15.0"
  }
}
