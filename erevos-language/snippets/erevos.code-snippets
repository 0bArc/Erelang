{
  "Action": {
    "prefix": "action",
    "body": [
      "public action ${1:name}(${2:param}: ${3:type}) {",
      "  ${0:// body}",
      "}"
    ],
    "description": "Create an action"
  },
  "Async Action": {
    "prefix": "async action",
    "body": [
      "public async action ${1:name}(${2:param}: ${3:type}): ${4:int} {",
      "  ${0:return 0;}",
      "}"
    ],
    "description": "Create an async action"
  },
  "Entity": {
    "prefix": "public entity",
    "body": [
      "entity ${1:Name} {",
      "  ${0}",
      "}"
    ],
    "description": "Create an entity"
  },
  "Array Literal": {
    "prefix": "arr",
    "body": [
      "Array<${1:int}> ${2:arr} = [${0:1, 2, 3}];"
    ],
    "description": "Create a typed array literal"
  },
  "Dictionary Literal": {
    "prefix": "dict",
    "body": [
      "Map<${1:string}, ${2:any}> ${3:dict} = {",
      "  \"${4:key}\": ${5:value}",
      "};"
    ],
    "description": "Create a typed dictionary literal"
  },
  "For Each Array": {
    "prefix": "forarr",
    "body": [
      "for (${1:v} : ${2:array}) {",
      "  ${0}",
      "}"
    ],
    "description": "Iterate array/list values with colon syntax"
  },
  "For Each Dict Key": {
    "prefix": "fordictk",
    "body": [
      "for (${1:k} : ${2:dictionary}) {",
      "  ${0}",
      "}"
    ],
    "description": "Iterate dictionary keys with colon syntax"
  },
  "For Each Dict Pair": {
    "prefix": "fordictkv",
    "body": [
      "for (${1:k}, ${2:v} : ${3:dictionary}) {",
      "  ${0}",
      "}"
    ],
    "description": "Iterate dictionary key/value pairs with colon syntax"
  },
  "Import Module": {
    "prefix": "import",
    "body": [
      "import \"${1:builtin/module}\" as ${2:mod};"
    ],
    "description": "Import a module with alias"
  },
  "Include Directive": {
    "prefix": "#include",
    "body": [
      "#include <${1:builtin/module}> as ${2:mod}"
    ],
    "description": "Include a builtin module with alias"
  },
  "Thread Spawn": {
    "prefix": "thread",
    "body": [
      "import \"builtin/threads\" as ${1:thread};",
      "",
      "public action ${2:worker} {",
      "    ${0}",
      "}",
      "",
      "public action main {",
      "    string tid = ${1:thread}.spawn(\"${2:worker}\");",
      "    ${1:thread}.join(tid);",
      "}"
    ],
    "description": "Create a worker thread pattern"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "    ${0}",
      "} catch (err) {",
      "    print err;",
      "}"
    ],
    "description": "Try-catch block"
  },
  "Match Guard": {
    "prefix": "caseif",
    "body": [
      "case ${1:Some}(${2:x}) if ${3:x > 0}: {",
      "    ${0}",
      "}"
    ],
    "description": "Match case with guard"
  },
  "Range For": {
    "prefix": "forrange",
    "body": [
      "for (int ${1:i} : ${2:0} .. ${3:10}) {",
      "    ${0}",
      "}"
    ],
    "description": "Inclusive range for-loop"
  },
  "Namespace": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:Name} {",
      "    public action ${2:fn}(${3:params}) {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Namespace block"
  },
  "Channel": {
    "prefix": "chan",
    "body": [
      "string ${1:ch} = chan_new(${2:0});",
      "chan_send(${1:ch}, ${3:\"msg\"});",
      "string ${4:v} = chan_recv(${1:ch});"
    ],
    "description": "Blocking channel send/recv"
  },
  "Alloc": {
    "prefix": "alloc",
    "body": [
      "*${1:int} ${2:p} = alloc<${1:int}>(${3:1});",
      "*${2:p} = ${4:0};",
      "free(${2:p});"
    ],
    "description": "Raw alloc/free"
  },
  "Heap": {
    "prefix": "heap",
    "body": [
      "heap<${1:int}> ${2:x} = heap<${1:int}>(${3:0});",
      "print *${2:x};"
    ],
    "description": "Unique heap owner"
  },
  "Pipe": {
    "prefix": "pipe",
    "body": [
      "#include <std/pipe>",
      "string ${1:p} = pipe.new(${2:2});",
      "${1:p}.send(\"${3:msg}\");",
      "print ${1:p}.receive();",
      "${1:p}.close();"
    ],
    "description": "std/pipe channel"
  },
  "Buffer": {
    "prefix": "buffer",
    "body": [
      "buffer<${1:u8}> ${2:data} = buffer<${1:u8}>(${3:64});",
      "${2:data}[0] = ${4:0};"
    ],
    "description": "Owned buffer"
  }
}
