{
  "Action": {
    "prefix": "action",
    "body": [
      "public action ${1:name}(${2:param}: ${3:type}) {",
      "  ${0:// body}",
      "}"
    ],
    "description": "Create an action"
  },
  "Entity": {
    "prefix": "public entity",
    "body": [
      "entity ${1:Name} {",
      "  ${0}",
      "}"
    ],
    "description": "Create an entity"
  },
  "Array Literal": {
    "prefix": "arr",
    "body": [
      "Array<${1:int}> ${2:arr} = [${0:1, 2, 3}];"
    ],
    "description": "Create a typed array literal"
  },
  "Dictionary Literal": {
    "prefix": "dict",
    "body": [
      "Map<${1:string}, ${2:any}> ${3:dict} = {",
      "  \"${4:key}\": ${5:value}",
      "};"
    ],
    "description": "Create a typed dictionary literal"
  },
  "For Each Array": {
    "prefix": "forarr",
    "body": [
      "for (${1:v} : ${2:array}) {",
      "  ${0}",
      "}"
    ],
    "description": "Iterate array/list values with colon syntax"
  },
  "For Each Dict Key": {
    "prefix": "fordictk",
    "body": [
      "for (${1:k} : ${2:dictionary}) {",
      "  ${0}",
      "}"
    ],
    "description": "Iterate dictionary keys with colon syntax"
  },
  "For Each Dict Pair": {
    "prefix": "fordictkv",
    "body": [
      "for (${1:k}, ${2:v} : ${3:dictionary}) {",
      "  ${0}",
      "}"
    ],
    "description": "Iterate dictionary key/value pairs with colon syntax"
  },
  "Import Module": {
    "prefix": "import",
    "body": [
      "import \"${1:builtin/module}\" as ${2:mod};"
    ],
    "description": "Import a module with alias"
  },
  "Include Directive": {
    "prefix": "#include",
    "body": [
      "#include <${1:builtin/module}> as ${2:mod}"
    ],
    "description": "Include a builtin module with alias"
  },
  "Thread Spawn": {
    "prefix": "thread",
    "body": [
      "import \"builtin/threads\" as ${1:thread};",
      "",
      "public action ${2:worker} {",
      "    ${0}",
      "}",
      "",
      "public action main {",
      "    string tid = ${1:thread}.spawn(\"${2:worker}\");",
      "    ${1:thread}.join(tid);",
      "}"
    ],
    "description": "Create a worker thread pattern"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "    ${0}",
      "} catch (err) {",
      "    print err;",
      "}"
    ],
    "description": "Try-catch block"
  }
}
