{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Erelang",
  "scopeName": "source.erelang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#includes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#entityDecl" },
    { "include": "#newExpr" },
    { "include": "#actionDecl" },
    { "include": "#foreachHeader" },
    { "include": "#typeAnnotation" },
    { "include": "#storageModifiers" },
    { "include": "#controlKeywords" },
    { "include": "#builtins" },
    { "include": "#memberAccess" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.erelang",
          "match": "//.*$"
        }
      ]
    },

    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.erelang",
          "match": "@[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "includes": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.erelang",
          "match": "^\\s*(#include)\\s*(<[^>]*>|\"[^\"]*\")?\\s*(\\bas\\b)?\\s*([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": { "name": "keyword.control.import.erelang" },
            "2": { "name": "string.unquoted.include.erelang" },
            "3": { "name": "keyword.other.erelang" },
            "4": { "name": "entity.name.namespace.erelang" }
          }
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.erelang",
          "match": "\"(?:\\\\.|[^\"\\\\])*\""
        }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.erelang", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
      ]
    },

    "constants": {
      "patterns": [
        { "name": "constant.language.erelang", "match": "\\b(true|false|null|nil|nullptr)\\b" }
      ]
    },

    "entityDecl": {
      "patterns": [
        {
          "match": "\\b(entity|struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.erelang" },
            "2": { "name": "entity.name.type.erelang" }
          }
        }
      ]
    },

    "newExpr": {
      "patterns": [
        {
          "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.new.erelang" },
            "2": { "name": "entity.name.type.erelang" }
          }
        }
      ]
    },

    "actionDecl": {
      "patterns": [
        {
          "match": "\\b(action)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.erelang" },
            "2": { "name": "entity.name.function.erelang" }
          }
        },
        {
          "match": "\\b(void|int|double|float|string|str|bool|char|auto|any|pointer|Array|Map|HashMap)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.erelang" },
            "2": { "name": "entity.name.function.erelang" }
          }
        }
      ]
    },

    "foreachHeader": {
      "patterns": [
        {
          "name": "meta.foreach.erelang",
          "match": "\\b(for)\\s*(\\()([^\\n)]*)(\\))?",
          "captures": {
            "1": { "name": "keyword.control.erelang" },
            "2": { "name": "punctuation.section.parens.begin.erelang" },
            "3": { "name": "variable.parameter.erelang" },
            "4": { "name": "punctuation.section.parens.end.erelang" }
          }
        }
      ]
    },

    "typeAnnotation": {
      "patterns": [
        {
          "name": "storage.type.erelang",
          "match": "\\b(void|int|double|float|string|str|bool|char|auto|any|pointer|Array|Map|HashMap|array|map|hashmap|dictionary|u8|u16|u32|u64|i8|i16|i32|i64|uint|unsigned)\\b"
        },
        {
          "name": "storage.type.erelang",
          "match": "\\b(Array|Map|HashMap)<[^>\\n]{0,80}>"
        }
      ]
    },

    "storageModifiers": {
      "patterns": [
        {
          "name": "storage.modifier.erelang",
          "match": "\\b(public|private|export|extern|const|constexpr|static|global|field|new|async|import|run|let|lambda)\\b"
        }
      ]
    },

    "controlKeywords": {
      "patterns": [
        {
          "name": "keyword.control.erelang",
          "match": "\\b(if|else|while|repeat|for|switch|match|case|default|break|continue|return|parallel|wait|all|fire|pause|try|catch|await|unsafe|namespace|hook|type)\\b"
        }
      ]
    },

    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.erelang",
          "match": "\\b(print|PRINT|sleep|input)\\b"
        }
      ]
    },

    "memberAccess": {
      "patterns": [
        {
          "name": "meta.member-access.erelang",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.erelang" },
            "2": { "name": "variable.other.property.erelang" }
          }
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.erelang", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.erelang", "match": "=" },
        { "name": "keyword.operator.logical.erelang",    "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.erelang", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.erelang",            "match": "::|\\.\\.\\." }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.erelang", "match": ";" },
        { "name": "punctuation.separator.erelang",            "match": "," },
        { "name": "punctuation.section.braces.begin.erelang", "match": "\\{" },
        { "name": "punctuation.section.braces.end.erelang",   "match": "\\}" },
        { "name": "punctuation.section.parens.begin.erelang", "match": "\\(" },
        { "name": "punctuation.section.parens.end.erelang",   "match": "\\)" }
      ]
    }

  }
}
