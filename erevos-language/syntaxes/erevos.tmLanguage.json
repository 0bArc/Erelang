{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Erelang",
  "scopeName": "source.erelang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#includes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#entityDecl" },
    { "include": "#actionDecl" },
    { "include": "#foreachHeader" },
    { "include": "#typeAnnotation" },
    { "include": "#storageModifiers" },
    { "include": "#controlKeywords" },
    { "include": "#builtinFunctions" },
    { "include": "#functionCall" },
    { "include": "#memberAccess" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.erelang",
          "match": "//.*$"
        }
      ]
    },

    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.erelang",
          "match": "@[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "includes": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.erelang",
          "match": "^\\s*(#include)\\s*(<[^>]*>|\"[^\"]*\")?\\s*(\\bas\\b)?\\s*([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": { "name": "keyword.control.import.erelang" },
            "2": { "name": "string.unquoted.include.erelang" },
            "3": { "name": "keyword.other.erelang" },
            "4": { "name": "entity.name.namespace.erelang" }
          }
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.erelang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.erelang", "match": "\\\\." },
            {
              "name": "meta.interpolation.erelang",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.erelang" } },
              "endCaptures":   { "0": { "name": "punctuation.definition.template-expression.end.erelang" } },
              "patterns": [
                { "include": "#numbers" },
                { "include": "#constants" },
                { "include": "#memberAccess" },
                { "include": "#operators" },
                { "name": "variable.other.readwrite.erelang", "match": "[A-Za-z_][A-Za-z0-9_]*" }
              ]
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.erelang", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
      ]
    },

    "constants": {
      "patterns": [
        { "name": "constant.language.erelang", "match": "\\b(true|false|null|nil|nullptr)\\b" }
      ]
    },

    "entityDecl": {
      "patterns": [
        {
          "match": "\\b(entity|struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.erelang" },
            "2": { "name": "entity.name.type.erelang" }
          }
        }
      ]
    },

    "actionDecl": {
      "patterns": [
        {
          "match": "\\b(action)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.erelang" },
            "2": { "name": "entity.name.function.erelang" }
          }
        }
      ]
    },

    "foreachHeader": {
      "patterns": [
        {
          "name": "meta.foreach.erelang",
          "begin": "\\b(for)\\s*(\\()",
          "end": "(\\))",
          "beginCaptures": {
            "1": { "name": "keyword.control.erelang" },
            "2": { "name": "punctuation.section.parens.begin.erelang" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.section.parens.end.erelang" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#typeAnnotation" },
            { "name": "keyword.operator.erelang", "match": "(:(?!:)|\\bin\\b)" },
            { "name": "keyword.operator.erelang", "match": "[=<>!]+|&&|\\|\\|" },
            { "name": "keyword.operator.erelang", "match": "[+\\-*/%]" },
            { "name": "punctuation.separator.erelang", "match": "," },
            { "name": "punctuation.terminator.erelang", "match": ";" },
            { "name": "variable.parameter.erelang", "match": "[A-Za-z_][A-Za-z0-9_]*" }
          ]
        }
      ]
    },

    "typeAnnotation": {
      "patterns": [
        {
          "name": "storage.type.erelang",
          "match": "\\b(void|int|double|float|string|str|bool|char|auto|any|pointer|Array|Map|HashMap|array|map|hashmap|dictionary|u8|u16|u32|u64|i8|i16|i32|i64|uint|unsigned)\\b"
        },
        {
          "name": "storage.type.erelang",
          "match": "\\b(Array|Map|HashMap)<[^>]*>"
        }
      ]
    },

    "storageModifiers": {
      "patterns": [
        {
          "name": "storage.modifier.erelang",
          "match": "\\b(public|private|export|extern|const|constexpr|static|global|field|new|async|import|run|let)\\b"
        }
      ]
    },

    "controlKeywords": {
      "patterns": [
        {
          "name": "keyword.control.erelang",
          "match": "\\b(if|else|while|repeat|for|switch|match|case|default|break|continue|return|parallel|wait|all|fire|pause|try|catch|await|unsafe|namespace|hook|type)\\b"
        }
      ]
    },

    "builtinFunctions": {
      "patterns": [
        {
          "name": "support.function.builtin.erelang",
          "match": "\\b(print|PRINT|sleep|now_ms|env|username|computer_name|machine_guid|uuid|rand_int|args_count|args_get|exec|spawn|exit|read_line|stdin_read|stderr_print|input|chdir|toint|toInt|tofloat|tostr|toString|tobool|to_json|from_json|sizeof|typeof|decltype|alignof|offsetof|ptr_new|ptr_get|ptr_set|ptr_free|ptr_valid|malloc|free|make_unique|make_shared|unique_reset|shared_reset|string\\.len|string\\.lower|string\\.upper|string\\.strip|string\\.lstrip|string\\.rstrip|string\\.starts_with|string\\.ends_with|string\\.find|string\\.substr|char_is_digit|char_is_space|char_is_alpha|char_is_ident_start|char_is_ident_part|set_new|set_add|set_has|set_remove|set_size|set_values|queue_new|queue_push|queue_pop|queue_peek|queue_len|queue_clear|file_open|file_close|file_read|file_write|file_seek|file_tell|file_flush|file_mtime|file_size|fopen|fclose|fread|fwrite|fseek|ftell|fflush|strbuf_new|strbuf_append|strbuf_clear|strbuf_len|strbuf_to_string|strbuf_free|strbuf_reserve|color\\.red|color\\.green|color\\.yellow|color\\.blue|color\\.magenta|color\\.cyan|color\\.bold|color\\.reset|table_new|table_put|table_get|table_has|table_remove|table_rows|table_columns|table_row_keys|table_clear_row|table_count_row)\\b(?=\\s*[\\(;\\s]|$)"
        }
      ]
    },

    "functionCall": {
      "patterns": [
        {
          "name": "meta.function-call.erelang",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.erelang" }
          }
        }
      ]
    },

    "memberAccess": {
      "patterns": [
        {
          "name": "meta.member-access.erelang",
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.erelang" },
            "2": { "name": "variable.other.property.erelang" }
          }
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.erelang", "match": "(?<![=!<>])=(?!=)" },
        { "name": "keyword.operator.comparison.erelang", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.erelang",    "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.erelang", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.bitwise.erelang",    "match": "&|\\||\\^|~|<<|>>" },
        { "name": "keyword.operator.erelang",            "match": "::|\\?\\.?|\\.\\.\\." }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.erelang", "match": ";" },
        { "name": "punctuation.separator.erelang",            "match": "," },
        { "name": "punctuation.section.braces.begin.erelang", "match": "\\{" },
        { "name": "punctuation.section.braces.end.erelang",   "match": "\\}" },
        { "name": "punctuation.section.parens.begin.erelang", "match": "\\(" },
        { "name": "punctuation.section.parens.end.erelang",   "match": "\\)" }
      ]
    }

  }
}
