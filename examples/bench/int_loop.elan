@erelang

// Sum 0..N-1; print INNER_MS and checksum so work cannot be DCE'd.
public action main() {
    int N = 5000000;
    int t0 = now_ms();
    int sum = 0;
    for (int i = 0; i < N; i++) {
        sum = sum + i;
    }
    int t1 = now_ms();
    print("INNER_MS=" + string(t1 - t0));
    print("SUM=" + string(sum));
}

run main;
