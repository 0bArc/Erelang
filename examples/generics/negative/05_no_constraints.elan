@strict

trait Comparable<T> {
    action compare(other: T): int;
}

trait Hashable {
    action hash(): int;
}

struct Neither {
    int value;
}

public action foo<T: Comparable<T> & Hashable>(x: T): int {
    return x.hash();
}

public action main() {
    Neither n;
    n.value = 1;
    int r = foo(n);
    print r;
}

run main;
