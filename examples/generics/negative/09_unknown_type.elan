@strict

trait Comparable<T> {
    action compare(other: T): int;
}

public action max<T: Comparable<T>>(a: T, b: T): T {
    if (a.compare(b) > 0) { return a; }
    return b;
}

struct NotComparable {
    int value;
}

public action main() {
    NotComparable a;
    a.value = 1;
    NotComparable b;
    b.value = 2;
    NotComparable x = max(a, b);
    print x.value;
}

run main;
