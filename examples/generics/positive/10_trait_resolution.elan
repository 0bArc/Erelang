@strict

trait Comparable<T> {
    action compare(other: T): int;
}

struct Score {
    int value;

    public action compare(other: Score): int {
        if (self.value > other.value) { return 1; }
        if (self.value < other.value) { return -1; }
        return 0;
    }
}

public action compareTwice<T: Comparable<T>>(a: T, b: T): int {
    return a.compare(b) + b.compare(a);
}

public action main() {
    Score a;
    a.value = 10;
    Score b;
    b.value = 3;
    int r = compareTwice(a, b);
    print r;
}

run main;
