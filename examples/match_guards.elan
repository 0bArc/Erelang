@strict

enum Color {
    Red,
    Green,
    Blue
}

enum OptionInt {
    Some(int),
    None
}


public action main() {
    OptionInt v = OptionInt.Some(5);
    match (v) {
        case Some(x) if x > 0: {
            print "positive";
        }
        case Some(x): {
            print "non-positive";
        }
        case None: {
            print "none";
        }
    }

    Color c = Color.Red;
    match (c) {
        case Red | Green: {
            print "warmish";
        }
        case Blue: {
            print "cool";
        }
    }

    Color c2 = Color.Blue;
    match (c2) {
        case Red | Green | Blue: {
            print "any";
        }
    }
}



run main;
