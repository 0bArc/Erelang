@erelang




public global MATH_PI = 3.141592653589793;
public global MATH_E  = 2.718281828459045;



public action sum(int x, int y) {
    return x + y;
}

public action sub(int x, int y) {
    return x - y;
}

public action mul(int x, int y) {
    return x * y;
}

public action div(int x, int y) {
    if (y == 0) {
        print "[Math Error] Division by zero";
        return 0;
    }
    return x / y;
}

public action mod(int x, int y) {
    return x % y;
}

public action pow(int base, int exp) {
    return base ^ exp;
}

public action abs(int val) {
    if (val < 0) {
        return 0 - val;
    }
    return val;
}

public action min(int x, int y) {
    if (x < y) { return x; }
    return y;
}

public action max(int x, int y) {
    if (x > y) { return x; }
    return y;
}


public action is_even(int n) {
    return (n % 2) == 0;
}



public int clamp(int val, int min_val, int max_val) {
    if (val < min_val) { return min_val; }
    if (val > max_val) { return max_val; }
    return val;
}