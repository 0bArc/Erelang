# Performance Benchmark: Sum of 100,000 Numbers
# This Erelang script computes the sum of numbers from 1 to 100,000
# and prints the result. Designed to test execution speed.

public action main {

let N = 100000;
let sum = 0;
let i = 1;

while (i <= N) {
    sum = sum + i;
    i = i + 1;
}

}

run main;