@strict

#include <builtin/fs> as fs
#include <builtin/data> as data
#include <builtin/ai> as ai

public action main() {
    print "=== fs + data + ai ===";
    print "";

    string work = fs.join(fs.cwd(), "examples", "_ai_fs_data");
    fs.mkdir(work);

    string blob_path = fs.join(work, "blob.txt");
    string report_path = fs.join(work, "report.txt");
    string store_path = fs.join(work, "state.txt");

    string u1 = uuid();
    string u2 = uuid();
    string blob = "order " + u1 + " mail me@corp.com noise ORD-0042-QA next " + u2 + " ip 10.0.0.7 end";
    fs.write(blob_path, blob);

    string raw = fs.read(blob_path);
    if (raw != blob) { fail("fs roundtrip mismatch"); }
    if (!fs.exists(blob_path)) { fail("blob missing"); }
    if (fs.size(blob_path) < 1) { fail("blob empty"); }

    print "[fs] wrote blob (" + string(fs.size(blob_path)) + " bytes)";
    print "     " + raw;
    print "";

    Array<string> ids = ai.extract(raw, "uuid");
    if (ids.len() != 2) { fail("expected 2 uuids got " + string(ids.len())); }
    if (!ai.validate("uuid", ids.get(0))) { fail("uuid0 invalid"); }
    if (!ai.validate("uuid", ids.get(1))) { fail("uuid1 invalid"); }
    if (ai.kind(ids.get(0)) != "uuid") { fail("kind not uuid"); }
    if (!ai.regex.test(ai.regex.of("uuid"), ids.get(0))) { fail("regex reject uuid0"); }

    Array<string> mails = ai.extract(raw, "email");
    if (mails.len() != 1) { fail("expected 1 email"); }
    Array<string> ips = ai.extract(raw, "ipv4");
    if (ips.len() != 1) { fail("expected 1 ipv4"); }

    print "[ai] extracted";
    print "  uuids (" + string(ids.len()) + "):";
    int ui = 0;
    while (ui < ids.len()) {
        string id = ids.get(ui);
        print "    " + id + "  kind=" + ai.kind(id) + "  ok=" + string(ai.validate("uuid", id));
        ui = ui + 1;
    }
    print "  email: " + mails.get(0);
    print "  ipv4:  " + ips.get(0);
    print "  redact: " + ai.redact_all(raw);
    print "";

    string uuid_rx = ai.auto(ids);
    if (!ai.regex.valid(uuid_rx)) { fail("inferred uuid regex invalid"); }
    if (!ai.regex.test(uuid_rx, u1)) { fail("inferred regex miss u1"); }
    if (!ai.regex.test(uuid_rx, u2)) { fail("inferred regex miss u2"); }

    string explained = ai.regex.explain(uuid_rx);
    if (string.len(explained) < 8) { fail("explain too short"); }

    print "[ai] uuid pattern";
    print "  regex:   " + uuid_rx;
    print "  explain: " + explained;
    print "";

    any store = data.new();
    data.set(store, "blob_path", blob_path);
    data.set(store, "uuid_count", string(ids.len()));
    data.set(store, "uuid0", ids.get(0));
    data.set(store, "uuid1", ids.get(1));
    data.set(store, "email0", mails.get(0));
    data.set(store, "ipv4_0", ips.get(0));
    data.set(store, "uuid_rx", uuid_rx);
    data.set(store, "uuid_explain", explained);
    data.set(store, "redacted", ai.redact_all(raw));

    string report = "";
    report = report + "uuid_rx=" + uuid_rx + "\n";
    report = report + "explain=" + explained + "\n";

    print "[ai] describe all kinds";
    Array<string> kinds = ai.names();
    int i = 0;
    while (i < kinds.len()) {
        string k = kinds.get(i);
        string desc = ai.describe(k);
        string ex = ai.example(k);
        string rx = ai.regex.of(k);
        string line = k + "|" + desc + "|" + ex + "|" + rx;
        data.set(store, "kind." + k, line);
        report = report + line + "\n";
        if (!ai.validate(k, ex)) { fail("example fails validate for " + k); }
        print "  " + k;
        print "    " + desc;
        print "    eg: " + ex;
        print "    rx: " + rx;
        i = i + 1;
    }
    print "";

    fs.write(report_path, report);
    data.save(store, store_path);

    any loaded = data.load(store_path);
    if (!data.has(loaded, "uuid0")) { fail("store missing uuid0"); }
    if (data.get(loaded, "uuid0") != u1) { fail("store uuid0 mismatch"); }
    if (data.get(loaded, "uuid1") != u2) { fail("store uuid1 mismatch"); }
    if (data.get(loaded, "email0") != "me@corp.com") { fail("store email mismatch"); }
    if (int(data.get(loaded, "uuid_count")) != 2) { fail("store count mismatch"); }

    string report2 = fs.read(report_path);
    if (string.len(report2) != string.len(report)) { fail("report size mismatch"); }
    if (!string.contains(report2, "uuid|")) { fail("report missing uuid kind"); }

    print "[data] saved + reloaded";
    print "  uuid0:  " + data.get(loaded, "uuid0");
    print "  uuid1:  " + data.get(loaded, "uuid1");
    print "  email:  " + data.get(loaded, "email0");
    print "  ipv4:   " + data.get(loaded, "ipv4_0");
    print "  count:  " + data.get(loaded, "uuid_count");
    print "  keys:   " + data.keys(loaded);
    print "";

    print "[fs] report @ " + report_path + " (" + string(fs.size(report_path)) + " bytes)";
    print "[fs] store  @ " + store_path + " (" + string(fs.size(store_path)) + " bytes)";
    print "";

    if (!fs.remove(blob_path)) { fail("remove blob"); }
    if (!fs.remove(report_path)) { fail("remove report"); }
    if (!fs.remove(store_path)) { fail("remove store"); }

    print "ok — fs + data + ai";
}

run main;
