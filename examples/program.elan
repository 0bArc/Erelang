@erelang
#include <builtin/network> as net

public action main {
    string html = net.get("https://stratware.win");
    int start = string.find(html, "<a ");
    if (start >= 0) {
        string sub = string.substr(html, start, 100);
        print sub;
    } else {
        print "no anchor tag found";
    }
}

run main;