@strict


struct Pair<A, B> {
    A first;
    B second;
}

enum Option<T> {
    Some(T),
    None
}

enum Result<T, E> {
    Ok(T),
    Error(E)
}

type StringMap<T> = Map<string, T>;

trait Comparable<T> {
    action compare(other: T): int;
}

struct Score {
    int value;

    public action compare(other: Score): int {
        if (self.value > other.value) { return 1; }
        if (self.value < other.value) { return -1; }
        return 0;
    }
}

public action identity<T>(value: T): T {
    return value;
}

public action first<A, B>(pair: Pair<A, B>): A {
    return pair.first;
}

public action max<T: Comparable<T> >(a: T, b: T): T {
    if (a.compare(b) > 0) {
        return a;
    }
    return b;
}

public action main() {
    int x = identity(42);
    string s = identity<string>("hello");
    print x;
    print s;

    Pair<int, string> p;
    p.first = 7;
    p.second = "seven";
    int f = first(p);
    print f;

    Option<int> some = Option<int>.Some(99);
    Option<int> none = Option<int>.None;
    match (some) {
        case Some(v): {
            print v;
        }
        case None: {
            print "empty";
        }
    }
    match (none) {
        case Some(v): {
            print v;
        }
        case None: {
            print "empty";
        }
    }

    Result<string, string> ok = Result<string, string>.Ok("loaded");
    match (ok) {
        case Ok(msg): {
            print msg;
        }
        case Error(err): {
            print err;
        }
    }

    Score a;
    a.value = 10;
    Score b;
    b.value = 3;
    print a.compare(b);
    Score winner = max(a, b);
    print winner.value;
}

run main;
