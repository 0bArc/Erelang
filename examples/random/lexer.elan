@strict

enum Tok {
    Ident(string),
    Number(string),
    StringLit(string),
    Symbol(string),
    Eof
}

public action show(Tok t) {
    match (t) {
        case Ident(s): {
            print "Ident {s}";
        }
        case Number(s): {
            print "Number {s}";
        }
        case StringLit(s): {
            print "String {s}";
        }
        case Symbol(s): {
            print "Symbol {s}";
        }
        case Eof: {
            print "Eof";
        }
    }
}

public action main() {
    string src = "let name = \"Ada\"; print add(1, 2);";
    int i = 0;
    int n = string.len(src);
    print "source: {src}";
    print "tokens:";

    while (i < n) {
        string c = string.substr(src, i, 1);
        if (char_is_space(c)) {
            i = i + 1;
        } else if (char_is_alpha(c) || c == "_") {
            int id_start = i;
            i = i + 1;
            while (i < n) {
                string d = string.substr(src, i, 1);
                if (char_is_alpha(d) || char_is_digit(d) || d == "_") {
                    i = i + 1;
                } else {
                    break;
                }
            }
            show(Tok.Ident(string.substr(src, id_start, i - id_start)));
        } else if (char_is_digit(c)) {
            int num_start = i;
            i = i + 1;
            while (i < n) {
                string d = string.substr(src, i, 1);
                if (char_is_digit(d)) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            show(Tok.Number(string.substr(src, num_start, i - num_start)));
        } else if (c == "\"") {
            i = i + 1;
            int str_start = i;
            while (i < n) {
                string d = string.substr(src, i, 1);
                if (d == "\"") {
                    break;
                }
                i = i + 1;
            }
            show(Tok.StringLit(string.substr(src, str_start, i - str_start)));
            if (i < n) {
                i = i + 1;
            }
        } else {
            show(Tok.Symbol(c));
            i = i + 1;
        }
    }
    show(Tok.Eof);
}

run main;
