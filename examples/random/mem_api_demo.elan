@strict

enum Option<T> {
    Some(T),
    None
}

public action main() {
    mem_reset_stats();

    *int p = alloc<int>();
    *p = 7;
    print *p;
    free(p);

    heap<string> s = heap<string>("hello");
    print *s;

    buffer<int> xs = buffer<int>(2);
    xs[0] = 10;
    xs[1] = 20;
    print xs[0];
    print xs[1];
    print xs.len();

    print mem_alive();
    print mem_stats();
    print "mem-api-ok";
}

run main;
