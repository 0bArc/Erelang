    print n;
}

action ret_int(): int {
    return 123;
}

action ret_bool_as_int(): int {
    return true;
}

action main() {
    int x = 1;
    any a = "hello";
    Array<any> loose_arr = [1];
    Array<int> nums = loose_arr;
    Map<any, any> loose_map = {"k": 1};
