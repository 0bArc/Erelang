@erelang
#include <builtin/websocket> as ws

public action main {
    sleep 800;
    ws.connect("ws://127.0.0.1:8080/ws");
    string sock = "" + _;
    print "connected=" + sock;
    if (sock == "null") {
        print "FAIL connect";
        return;
    }
    sock.send("hello-ws");
    sock.recv_timeout("3000");
    print "recv=" + _;
    sock.close();
}

run main;
