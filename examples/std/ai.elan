@erelang

// builtin/ai: pattern intelligence, so you rarely write a regex by hand.
// Everything runs offline and deterministically. See docs/pages/modules/ai.md.

#include <builtin/ai> as ai

public action main() {
    // Detect what the samples are and infer a regex.
    string pattern = ai.auto([
        "ORD-0042-QA",
        "ORD-1937-QA",
        "ORD-8521-QA"
    ]);
    print "auto:      " + pattern;

    // Explicitly request regex inference.
    string rx = ai.infer.regex([
        "user_001@example.com",
        "user_002@example.com",
        "user_003@example.com"
    ]);
    print "infer:     " + rx;

    // Generate a pattern from a description.
    string email = ai.regex.generate("Match a corporate email address ending in .com");
    print "generate:  " + email;
    print "  me@corp.com   -> " + string(ai.regex.test(email, "me@corp.com"));
    print "  me@corp.org   -> " + string(ai.regex.test(email, "me@corp.org"));

    // Explain an existing pattern.
    print "explain:   " + ai.regex.explain(rx);

    // Simplify a needlessly long pattern.
    string messy = "[0-9][0-9][0-9]-(?:a|b|c)-[0-9]{1}[0-9]{2}";
    print "optimize:  " + ai.regex.optimize(messy) + "   (was " + messy + ")";

    // Sample strings a pattern accepts.
    Array<string> shown = ai.regex.examples(ai.regex.generate("3 digits then a dash then 2 uppercase letters"), 3);
    for (string s : shown) { print "example:   " + s; }

    // Pull things out of text, or hide them.
    string note = "Mail me@site.io or you@corp.com, server 10.0.0.7, order 2026-10-21.";
    Array<string> mails = ai.extract(note, "email");
    for (string m : mails) { print "found:     " + m; }
    print "redacted:  " + ai.redact_all(note);

    // What does this text look like?
    print "kind:      " + ai.kind("12:30") + ", " + ai.kind("0xFF") + ", " + ai.kind("hello world");
    print "ai-intelligence-ok";
}
run main;
