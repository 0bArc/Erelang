@erelang

// Test 1: named import syntax
// import {helper, util} from "builtin/test_import"

// Test 2: array literals are native
public action test_arrays {
    Array<int> nums = [2, 4, 6, 8];
    print "array length works natively";
}

// Test 3: map literals are native
public action test_maps {
    Map<string, any> data = {
        "key1": 42,
        "key2": "hello"
    };
    print "map literal works natively";
}

public action main {
    test_arrays();
    test_maps();
    print "=== All tests passed ===";
}

run main;
