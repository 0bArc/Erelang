@erelang
#include <builtin/threads> as threads

public action background_task {
    threads.sleep(1000);
    print "background work complete";
}

public action main {
    string tid = threads.spawn("background_task");
    print "launched thread id: {tid}";
    print "waiting for thread to finish...";
    threads.join(tid);
    string active = threads.active();
    print "active threads remaining: {active}";
    threads.gc();
    print "thread cleanup complete";
}

run main;
