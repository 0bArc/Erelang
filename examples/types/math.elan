@erelang

// The math library. Run: erelang examples/types/math.elan

#include <builtin/math>

public action check(label: string, got: string, want: string) {
    if (got != want) { fail(label + ": got [" + got + "] want [" + want + "]"); }
    print "  " + label + " = " + got;
}

public action main() {
    print "integers";
    check("add", string(math.add(2, 3)), "5");
    check("gcd", string(math.gcd(12, 18)), "6");
    check("lcm", string(math.lcm(4, 6)), "12");
    check("factorial", string(math.factorial(10)), "3628800");
    check("is_prime", string(math.is_prime(97)), "true");
    check("clamp", string(math.clamp(15, 0, 10)), "10");
    check("sign", string(math.sign(-9)), "-1");
    check("abs", string(math.abs(-7)), "7");

    print "rounding";
    check("floor", string(math.floor(2.7)), "2");
    check("ceil", string(math.ceil(2.1)), "3");
    check("round", string(math.round(2.5)), "3");
    check("trunc", string(math.trunc(-2.7)), "-2");

    print "floats";
    check("sqrt", string(math.sqrt(144)), "12.0");
    check("pow", string(math.pow(2, 0.5) > 1.41), "true");
    check("hypot", string(math.hypot(3, 4)), "5.0");
    check("lerp", string(math.lerp(0, 10, 0.25)), "2.5");
    check("sin(0)", string(math.sin(0)), "0.0");
    check("cos(0)", string(math.cos(0)), "1.0");
    check("pi", string(math.pi() > 3.14 && math.pi() < 3.15), "true");
    check("degrees", string(math.round(math.degrees(math.pi()))), "180");

    print "sequences";
    check("collatz 27", string(math.collatz_len(27)), "111");

    print "math-ok";
}
run main;
