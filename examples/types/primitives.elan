@erelang

// Primitive types: int, float, bool, string, and how they convert.
// Run: erelang examples/types/primitives.elan

public action check(label: string, got: string, want: string) {
    if (got != want) { fail(label + ": got [" + got + "] want [" + want + "]"); }
    print "  " + label + " = " + got;
}

public action main() {
    print "ints are 64-bit and exact";
    int big = 9007199254740993;          // beyond what a double can hold exactly
    check("big + 1", string(big + 1), "9007199254740994");
    check("integer division truncates", string(7 / 2), "3");
    check("remainder keeps the sign of the left side", string(-7 % 3), "-1");
    int maxInt = 9223372036854775807;
    check("overflow wraps around", string(maxInt + 1), "-9223372036854775808");

    print "floats are doubles and print in their shortest exact form";
    float third = 1.0 / 3.0;
    check("1/3", string(third), "0.3333333333333333");
    check("0.1 + 0.2", string(0.1 + 0.2), "0.30000000000000004");
    check("a whole float keeps its point", string(2.0 * 3.0), "6.0");
    check("int and float mix to float", string(7 / 2.0), "3.5");
    check("negative power gives a float", string(2 ** -2), "0.25");

    print "bools";
    bool ready = 3 > 2 && !(1 == 2);
    check("logic", string(ready), "true");
    check("bool to int", string(int(true) + int(true)), "2");

    print "strings";
    string name = "Erelang";
    check("length", string(name.len()), "7");
    check("upper", name.upper(), "ERELANG");
    check("slice", string.substr(name, 0, 3), "Ere");
    check("find", string(name.find("lang")), "3");
    check("leading zeros survive", "007".upper(), "007");
    check("interpolation", "hello {name}", "hello Erelang");
    check("repeat", "ab".repeat(3), "ababab");

    print "conversions";
    check("string to int", string(int("42") + 1), "43");
    check("string to float", string(float("2.5") * 2), "5.0");
    check("float to int truncates", string(int(9.99)), "9");
    check("int to string", "n=" + string(12), "n=12");

    print "primitives-ok";
}
run main;
