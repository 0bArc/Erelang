// Discord gateway client for Erelang.
//
// discord_run() connects, identifies, heartbeats, dispatches events to the handlers you register,
// and reconnects (resuming the session when it can) until discord_stop() is called or Discord
// closes the connection with a fatal code.
//
// Handlers are plain action names, registered with discord_on_*:
//   discord_on_ready("h")    -> action h(user_id: string, user_name: string)
//   discord_on_message("h")  -> action h(channel_id: string, author_id: string, author_name: string, content: string, message_id: string)
//   discord_on_command("h")  -> action h(name: string, options_json: string, interaction_id: string, interaction_token: string, user_id: string)
//   discord_on_event("h")    -> action h(event_type: string, data_json: string)   (every dispatch)

#include <builtin/websocket> as ws

global int discord_intents = 513;
global string discord_gateway_query = "/?v=10&encoding=json";
global string discord_h_ready = "";
global string discord_h_message = "";
global string discord_h_command = "";
global string discord_h_event = "";
global int discord_running = 0;
global int discord_seq = -1;
global string discord_session_id = "";
global string discord_resume_url = "";
global string discord_user_id = "";
global int discord_hb_interval = 41250;
global int discord_hb_next = 0;
global int discord_hb_acked = 1;
global int discord_ignore_bots = 1;

public action discord_on_ready(handler: string) { discord_h_ready = handler; }
public action discord_on_message(handler: string) { discord_h_message = handler; }
public action discord_on_command(handler: string) { discord_h_command = handler; }
public action discord_on_event(handler: string) { discord_h_event = handler; }
public action discord_set_intents(bits: int) { discord_intents = bits; }
public action discord_stop() { discord_running = 0; }

// ---- Frames -----------------------------------------------------------------

action discord_gw_send_heartbeat(sock: string) {
    string d = "null";
    if (discord_seq >= 0) { d = string(discord_seq); }
    sock.send("{\"op\":1,\"d\":" + d + "}");
    discord_hb_acked = 0;
    discord_hb_next = now_ms() + discord_hb_interval;
}

action discord_gw_identify(sock: string) {
    string props = "{\"os\":\"erelang\",\"browser\":\"erelang\",\"device\":\"erelang\"}";
    string d = "{\"token\":" + discord_q(discord_token) + ",\"intents\":" + string(discord_intents) + ",\"properties\":" + props + "}";
    sock.send("{\"op\":2,\"d\":" + d + "}");
}

action discord_gw_resume(sock: string) {
    string d = "{\"token\":" + discord_q(discord_token) + ",\"session_id\":" + discord_q(discord_session_id) + ",\"seq\":" + string(discord_seq) + "}";
    sock.send("{\"op\":6,\"d\":" + d + "}");
}

// ---- Dispatch ---------------------------------------------------------------

action discord_gw_dispatch(event_type: string, data: string) {
    if (discord_h_event != "") { call_action(discord_h_event, event_type, data); }

    if (event_type == "READY") {
        Map<string, string> ready = from_json(data);
        discord_session_id = ready["session_id"];
        discord_resume_url = ready["resume_gateway_url"];
        Map<string, string> user = from_json(ready["user"]);
        discord_user_id = user["id"];
        if (discord_h_ready != "") { call_action(discord_h_ready, user["id"], user["username"]); }
    } else if (event_type == "MESSAGE_CREATE") {
        if (discord_h_message == "") { return; }
        Map<string, string> msg = from_json(data);
        Map<string, string> author = from_json(msg["author"]);
        if (discord_ignore_bots == 1 && (author["bot"] == "true" || author["id"] == discord_user_id)) { return; }
        call_action(discord_h_message, msg["channel_id"], author["id"], author["username"], msg["content"], msg["id"]);
    } else if (event_type == "INTERACTION_CREATE") {
        if (discord_h_command == "") { return; }
        Map<string, string> it = from_json(data);
        if (it["type"] != "2") { return; }
        Map<string, string> cmd = from_json(it["data"]);
        string who = "";
        if (it.has("member")) {
            Map<string, string> member = from_json(it["member"]);
            Map<string, string> mu = from_json(member["user"]);
            who = mu["id"];
        } else if (it.has("user")) {
            Map<string, string> du = from_json(it["user"]);
            who = du["id"];
        }
        string options = "[]";
        if (cmd.has("options")) { options = cmd["options"]; }
        call_action(discord_h_command, cmd["name"], options, it["id"], it["token"], who);
    }
}

// Value of a named option from a command's options_json, or "" when absent.
public action discord_option(options_json: string, name: string): string {
    Array<string> items = discord_json_items(options_json);
    for (string raw : items) {
        Map<string, string> opt = from_json(raw);
        if (opt["name"] == name) { return opt["value"]; }
    }
    return "";
}

// ---- Session ----------------------------------------------------------------

// Run one gateway connection. Returns 0 to retry with resume, 1 to retry with a fresh session,
// 2 to stop for good.
action discord_gw_session(url: string): int {
    string target = url;
    if (string.find(target, "?") < 0) { target = target + discord_gateway_query; }
    string sock = ws.connect(target);
    string st = sock.state();
    if (st != "open") {
        print "discord: gateway connect failed";
        return 1;
    }
    discord_hb_acked = 1;
    discord_hb_next = 0;
    int resuming = 0;
    if (discord_session_id != "" && discord_seq >= 0) { resuming = 1; }
    int started = 0;
    while (discord_running == 1) {
        if (started == 1 && now_ms() >= discord_hb_next) {
            if (discord_hb_acked == 0) {
                print "discord: heartbeat not acknowledged, reconnecting";
                sock.close();
                return 0;
            }
            discord_gw_send_heartbeat(sock);
        }
        string raw = sock.recv_timeout(100);
        if (raw == "") {
            st = sock.state();
            if (st != "open") {
                string code = sock.close_code();
                sock.close();
                print "discord: gateway closed (" + code + ")";
                if (code == "4004" || code == "4010" || code == "4011" || code == "4012" || code == "4013" || code == "4014") {
                    print "discord: fatal close code, check token and intents";
                    return 2;
                }
                if (code == "4007" || code == "4009") { return 1; }
                return 0;
            }
            continue;
        }
        Map<string, string> frame = from_json(raw);
        string op = frame["op"];
        if (frame.has("s") && frame["s"] != "nullptr" && frame["s"] != "") { discord_seq = int(frame["s"]); }
        if (op == "0") {
            discord_gw_dispatch(frame["t"], frame["d"]);
        } else if (op == "10") {
            Map<string, string> hello = from_json(frame["d"]);
            discord_hb_interval = int(hello["heartbeat_interval"]);
            discord_hb_next = now_ms() + discord_hb_interval / 2;
            started = 1;
            if (resuming == 1) { discord_gw_resume(sock); } else { discord_gw_identify(sock); }
        } else if (op == "11") {
            discord_hb_acked = 1;
        } else if (op == "1") {
            discord_gw_send_heartbeat(sock);
        } else if (op == "7") {
            sock.close();
            return 0;
        } else if (op == "9") {
            sock.close();
            if (frame["d"] == "true") { return 0; }
            return 1;
        }
    }
    sock.close();
    return 2;
}

// Connect and process events until discord_stop() or a fatal error. Returns 0 on a clean stop.
public action discord_run(): int {
    if (discord_token == "") {
        print "discord: no token, call discord_login(token) first";
        return 1;
    }
    discord_running = 1;
    int failures = 0;
    while (discord_running == 1) {
        string url = "";
        if (discord_session_id != "" && discord_resume_url != "") {
            url = discord_resume_url;
        } else {
            url = discord_get_gateway_url();
        }
        if (url == "") {
            failures = failures + 1;
            print "discord: could not get gateway url";
            discord_wait(1000 * failures);
            if (failures >= 5) { return 1; }
            continue;
        }
        int rc = discord_gw_session(url);
        if (rc == 2) {
            discord_running = 0;
            return 0;
        }
        if (rc == 1) {
            discord_session_id = "";
            discord_resume_url = "";
            discord_seq = -1;
        }
        discord_wait(500);
    }
    return 0;
}
