// Quick register helpers
action slash_register_ping() -> string {
    return discord_create_command("ping", "Replies with pong!", "");
}

action slash_register_echo() -> string {
    string opts = "[" + slash_option_string("message", "The message to echo", "true") + "]";
    return discord_create_command("echo", "Echoes your message", opts);
}
