// SlashCommandBuilder for erelang
// Direct JSON string building - no collections needed

action slash_option_string(string name, string description, string required) -> string {
    string r = "{\"name\":\"" + name + "\",\"description\":\"" + description + "\",\"type\":3";
    if (required == "true") { r = r + ",\"required\":true"; }
    return r + "}";
}

action slash_option_integer(string name, string description, string required) -> string {
    string r = "{\"name\":\"" + name + "\",\"description\":\"" + description + "\",\"type\":4";
    if (required == "true") { r = r + ",\"required\":true"; }
    return r + "}";
}

