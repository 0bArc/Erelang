#!/bin/sh
# Stand-in for the docker CLI used by the plugin tests on Linux and macOS. Same behavior as docker.cmd.
echo "$*" >> "$FAKE_DOCKER_LOG"
case "$1" in
  --version) echo "Docker version 99.0.0, build fake"; exit 0 ;;
  info|version) echo "99.0.0"; exit 0 ;;
  ps)
    if [ "$2" = "--format" ]; then echo web; echo db; exit 0; fi
    echo '{"ID":"c0ffee123","Names":"web","Image":"nginx","Status":"Up 2 minutes"}'
    echo '{"ID":"deadbeef","Names":"db","Image":"postgres","Status":"Up 5 minutes"}'
    exit 0 ;;
  images) echo '{"Repository":"nginx","Tag":"latest","ID":"sha256:abc"}'; exit 0 ;;
  run) echo c0ffee123; exit 0 ;;
  stop|start) echo "$2"; exit 0 ;;
  rm) echo removed; exit 0 ;;
  logs) echo "line one"; echo "line two"; exit 0 ;;
  exec) echo exec-output; exit 0 ;;
  inspect)
    if [ "$2" = "--format" ]; then echo running; exit 0; fi
    if [ "$2" = "missing" ]; then echo "Error: No such object: missing" >&2; exit 1; fi
    echo '[{"Id":"c0ffee123","Name":"/web","State":{"Status":"running","Running":true,"Pid":4242},"Config":{"Image":"nginx"}}]'
    exit 0 ;;
  compose) echo "compose $2"; exit 0 ;;
esac
echo "unknown command $1" >&2
exit 1
