@strict

trait Comparable<T> {
    action compare(other: T): int;
}

trait Hashable {
    action hash(): int;
}

struct Score {
    int value;

    public action compare(other: Score): int {
        if (self.value > other.value) { return 1; }
        if (self.value < other.value) { return -1; }
        return 0;
    }

    public action hash(): int {
        return self.value;
    }
}

public action foo<T: Comparable<T> & Hashable>(x: T): int {
    return x.hash() + x.compare(x);
}

public action main() {
    Score s;
    s.value = 4;
    int r = foo(s);
    print r;
    print "generics-multi-ok";
}

run main;
