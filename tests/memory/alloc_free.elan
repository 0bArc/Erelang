@strict

enum Option<T> {
    Some(T),
    None
}

public action main() {
    *int p = alloc<int>();
    *p = 42;
    print *p;
    free(p);

    *int q = alloc<int>(4);
    *q = 1;
    *(q + 1) = 2;
    *(q + 2) = 3;
    print *q;
    print *(q + 1);
    print *(q + 2);
    free(q);

    print sizeof<int>();
    print alignof<u8>();
    print "alloc-ok";
}

run main;
