@erelang

// Background processes, JSON, the math module, new string methods and bitwise compound assignment.

#include <builtin/system> as sys
#include <builtin/json> as json
#include <builtin/math> as math

public action eq(label: string, got: string, want: string) {
    if (got != want) { fail(label + ": got [" + got + "] want [" + want + "]"); }
}

public action yes(label: string, ok: bool) {
    if (!ok) { fail(label + ": expected true"); }
}

public action main() {
    // ---- processes ---------------------------------------------------------------------------
    string out = sys.cmd("echo hello-cmd");
    yes("cmd output", string.contains(out, "hello-cmd"));
    eq("cmd exit", string(sys.last_exit()), "0");

    string os = sys.os();
    yes("os name", os == "windows" || os == "linux" || os == "macos");
    bool win = os == "windows";

    // execute passes each argument on its own, no shell.
    int code = 0;
    if (win) { code = sys.execute("cmd.exe", "/C", "exit", "3"); }
    else { code = sys.execute("sh", "-c", "exit 3"); }
    eq("execute exit code", string(code), "3");

    string twoStep = "echo started; sleep 1; echo done";
    string longWait = "sleep 30";
    string filter = "grep x";
    if (win) {
        twoStep = "echo started & ping -n 2 127.0.0.1 > nul & echo done";
        longWait = "ping -n 30 127.0.0.1 > nul";
        filter = "findstr x";
    }

    string p = sys.start(twoStep);
    yes("handle prefix", string.starts_with(p, "proc:"));
    yes("alive right after start", p.alive());
    string finished = p.wait(10000);
    eq("wait exit code", finished, "0");
    yes("not alive after wait", !p.alive());
    string text = p.output();
    yes("captured first line", string.contains(text, "started"));
    yes("captured last line", string.contains(text, "done"));

    string slow = sys.start(longWait);
    eq("wait timeout gives empty", slow.wait(100), "");
    yes("kill", slow.kill());
    slow.wait(5000);
    yes("dead after kill", !slow.alive());

    string writer = sys.start(filter);
    writer.write("one x\ntwo\nthree x\n");
    writer.close_input();
    writer.wait(10000);
    string found = writer.output();
    yes("stdin reached child", string.contains(found, "one x") && string.contains(found, "three x"));
    yes("filter worked", !string.contains(found, "two"));

    // ---- json --------------------------------------------------------------------------------
    any doc = json.parse("{\"name\": \"erelang\", \"tags\": [\"a\", \"b\"], \"n\": 3, \"ok\": true, \"none\": null}");
    eq("stringify sorted", json.stringify(doc), "{\"n\":3,\"name\":\"erelang\",\"none\":null,\"ok\":true,\"tags\":[\"a\",\"b\"]}");
    yes("valid", json.valid("[1, 2, {\"a\": [true]}]"));
    yes("invalid", !json.valid("{\"a\": }"));
    eq("encode", json.encode("say \"hi\""), "\"say \\\"hi\\\"\"");

    Array<string> items = from_json("[{\"id\": 1}, {\"id\": 2}]");
    eq("from_json array length", string(items.len()), "2");
    Map<string, string> second = from_json(items[1]);
    eq("from_json nested", second["id"], "2");

    Map<string, int> counts = {"a": 1, "b": 2};
    string asJson = to_json(counts);
    yes("to_json numbers unquoted", string.contains(asJson, "\"a\":1") && string.contains(asJson, "\"b\":2"));

    // ---- math --------------------------------------------------------------------------------
    eq("sqrt is float", string(math.sqrt(16)), "4.0");
    eq("pow", string(math.pow(2, 10)), "1024.0");
    eq("floor", string(math.floor(2.7)), "2");
    eq("ceil", string(math.ceil(2.1)), "3");
    eq("round", string(math.round(-2.5)), "-3");
    eq("clamp int", string(math.clamp(15, 0, 10)), "10");
    eq("min keeps int", string(math.min(3, 7)), "3");
    eq("max float", string(math.max(1.5, 1)), "1.5");
    eq("abs", string(math.abs(-9)), "9");
    eq("gcd", string(math.gcd(84, 36)), "12");
    eq("lcm", string(math.lcm(4, 6)), "12");
    yes("is_prime 97", math.is_prime(97));
    yes("not prime 91", !math.is_prime(91));
    eq("factorial", string(math.factorial(10)), "3628800");
    eq("hypot", string(math.hypot(3, 4)), "5.0");
    eq("lerp", string(math.lerp(0, 10, 0.25)), "2.5");
    eq("degrees", string(math.round(math.degrees(math.pi()))), "180");
    eq("collatz", string(math.collatz_len(27)), "111");

    // ---- strings -----------------------------------------------------------------------------
    string s = "007";
    eq("upper keeps string", s.upper(), "007");
    yes("contains method", "erelang".contains("lang"));
    eq("repeat", "ab".repeat(3), "ababab");
    eq("reverse", "abc".reverse(), "cba");

    // ---- bitwise compound assignment ---------------------------------------------------------
    int flags = 12;
    flags &= 10;
    eq("and-assign", string(flags), "8");
    flags |= 3;
    eq("or-assign", string(flags), "11");
    flags ^= 1;
    eq("xor-assign", string(flags), "10");
    flags <<= 2;
    eq("shl-assign", string(flags), "40");
    flags >>= 3;
    eq("shr-assign", string(flags), "5");

    print "process-json-math-ok";
}
run main;
